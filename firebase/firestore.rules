rules_version = '2';

// Reglas de seguridad de Firestore — Metamorfosis Real
//
// Modelo: cada user tiene su propio doc en users/{uid} (uid de Firebase Auth).
// Lectura/escritura desde el cliente (Web SDK) están restringidas al dueño.
// El backend con Admin SDK (firebaseAdmin.ts) bypasa estas rules y puede
// hacer escrituras administrativas sobre cualquier doc.
//
// Despliegue:
//   - firebase deploy --only firestore:rules
//   - o pegar este archivo en Firebase Console → Firestore → Rules → Publish.
//
// Ver specs/SPEC-008-firestore-rules.md

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== users/{uid} =====
    // Solo el dueño puede leer/escribir su propio doc.
    // El bloque `app.*` está reservado para ElenaApp; web no debe tocarlo
    // desde el cliente (la app móvil sí, autenticada como el mismo uid).
    // El bloque `crm.*` (SPEC-016b) es metadata operativa del admin
    // (status, notes, tags); el dueño NO debe poder modificarlo.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && (
                      // Si la request no toca el campo `app`, OK
                      !('app' in request.resource.data.keys())
                      // Si lo toca, debe quedar idéntico al actual (no edita app.*)
                      || request.resource.data.app == resource.data.app
                    )
                    && (
                      // Mismo principio para `crm`: el dueño no puede tocarlo
                      !('crm' in request.resource.data.keys())
                      || request.resource.data.crm == resource.data.crm
                    )
                    && (
                      // SPEC-056: `founder` solo lo escribe el Admin SDK
                      // (assignFounderIfEligible dentro de una runTransaction
                      // que también incrementa el counter). El dueño NO debe
                      // poder reclamar isFounder=true ni cambiar su number.
                      !('founder' in request.resource.data.keys())
                      || request.resource.data.founder == resource.data.founder
                    );
      allow delete: if false; // nunca desde cliente

      // Subcolección daily_logs: planeada para ElenaApp (registro diario de
      // ayuno, comidas, ejercicio, sueño). Solo el dueño accede.
      match /daily_logs/{date} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Subcolección article_quizzes: respuestas a quizzes de artículos.
      // Hoy ArticleQuiz.tsx guarda en users/{uid}.completedQuizzes (array
      // del doc raíz), pero dejamos esta subcolección habilitada por si
      // migramos a estructura por slug en el futuro.
      match /article_quizzes/{slug} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // SPEC-042: bookmarks de topics del foro. El endpoint
      // /api/forum/topics/[id]/save usa Admin SDK, pero permitimos read
      // al dueño desde el cliente para que pueda listar sus guardados sin
      // pasar siempre por endpoint. Write bloqueado al cliente para
      // mantener consistencia con la metadata cached y el audit log.
      match /savedTopics/{topicId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // SPEC-043: notificaciones in-app del foro. El endpoint
      // /api/users/me/notifications (Admin SDK) crea/marca-read; el
      // cliente solo lee su propia subcolección.
      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // ===== metamorfosis_posts =====
    // Lectura pública (artículos del blog) — biblioteca y posts/[slug] los
    // sirven SSR con Admin SDK, pero también el cliente podría leerlos
    // (ej. quiz de artículo carga preguntas). Escritura solo desde Admin SDK
    // (panel admin) que bypasa rules.
    match /metamorfosis_posts/{post} {
      allow read: if true;
      allow write: if false;

      // ===== reactions/{uid} (SPEC-032) =====
      // Likes/dislikes por user. Read solo a logueados (no exponemos
      // identidad de votantes a anónimos). Write SIEMPRE bloqueado al
      // cliente: el endpoint /api/posts/[slug]/react usa Admin SDK con
      // transaction atómica para mantener counters denormalizados
      // sincronizados; permitir writes directos rompería la consistencia.
      match /reactions/{uid} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ===== waitlist_leads =====
    // Anónimos pueden crear leads pre-auth (form de captura). Se valida
    // mínimo email no vacío. Lectura/modificación solo desde Admin SDK.
    match /waitlist_leads/{lead} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() > 0;
      allow read, update, delete: if false;
    }

    // ===== pruebas =====
    // Datos analíticos / test internos. Solo Admin SDK accede.
    match /pruebas/{doc} {
      allow read, write: if false;
    }

    // ===== forum_topics (SPEC-033) =====
    // Foro de comunidad. Read público sobre topics activos (anónimos pueden
    // ver, no comentar). Writes SIEMPRE bloqueados al cliente: las mutaciones
    // van por endpoints `/api/forum/*` con Admin SDK + transactions atómicas
    // que mantienen counters denormalizados (replyCount, likeCount, views)
    // sincronizados.
    match /forum_topics/{topic} {
      allow read: if !('status' in resource.data) || resource.data.status == 'active';
      allow write: if false;

      match /replies/{reply} {
        allow read: if !('status' in resource.data) || resource.data.status == 'active';
        allow write: if false;
      }

      match /likes/{uid} {
        // Lectura solo para logueados (no exponemos identidad de votantes)
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ===== system/{doc} (SPEC-056) =====
    // Documentos de sistema (counters atómicos, feature flags). Solo Admin SDK
    // accede. Cliente no debe poder leer/modificar — especialmente
    // `system/counters.founderCount` que define el cap de cohorte fundador.
    // Si el cliente pudiera leer, podría exponerlo en UI no autorizada; si
    // pudiera modificar, rompería el cap de 1000.
    match /system/{doc} {
      allow read, write: if false;
    }

    // ===== admin_audit_log (SPEC-018) =====
    // Audit log de mutaciones admin. Lectura/escritura SOLO desde Admin SDK
    // (los handlers /api/admin/* lo escriben con el helper logAdminAction).
    // El cliente Web SDK no debe poder leerlo aunque sea admin (defensa en
    // profundidad: si la cookie admin se filtrara, el atacante no podría
    // borrar el rastro desde el browser).
    match /admin_audit_log/{doc} {
      allow read, write: if false;
    }

    // ===== elena_support_tickets (SPEC-112) =====
    // Tickets de soporte de ElenaApp. Escritura SOLO desde el endpoint
    // POST /api/support/elena con Admin SDK (que bypasea rules): valida
    // Content-Type, honeypot, rate limit y Bearer token opcional antes de
    // persistir. Lectura SOLO desde endpoints admin server-side (patrón
    // igual a admin_audit_log). El cliente no debe poder listar ni crear
    // tickets directamente para no bypasear las protecciones anti-spam.
    match /elena_support_tickets/{ticket} {
      allow read, write: if false;
    }

    // ===== Default deny =====
    // Cualquier path no enumerado arriba queda bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
