---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Tu Diagnóstico Metabólico | Metamorfosis Real">
    <div
        class="min-h-screen bg-gray-900 text-white flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8"
    >
        <div
            id="result-container"
            class="max-w-3xl w-full space-y-8 text-center hidden"
        >
            <!-- Score Circle -->
            <div class="relative w-48 h-48 mx-auto">
                <svg class="w-full h-full transform -rotate-90">
                    <circle
                        cx="96"
                        cy="96"
                        r="88"
                        stroke="currentColor"
                        stroke-width="12"
                        fill="transparent"
                        class="text-gray-700"></circle>
                    <circle
                        id="score-circle"
                        cx="96"
                        cy="96"
                        r="88"
                        stroke="currentColor"
                        stroke-width="12"
                        fill="transparent"
                        stroke-dasharray="553"
                        stroke-dashoffset="553"
                        class="transition-all duration-1000 ease-out"></circle>
                </svg>
                <div
                    class="absolute inset-0 flex flex-col items-center justify-center"
                >
                    <span id="score-value" class="text-5xl font-extrabold"
                        >0</span
                    >
                    <span
                        class="text-sm text-gray-400 uppercase tracking-widest mt-1"
                        >Puntos IMR</span
                    >
                </div>
            </div>

            <!-- Level Title -->
            <div>
                <h1
                    id="level-title"
                    class="text-4xl sm:text-5xl font-black tracking-tight mb-4"
                >
                    <!-- Injected via JS -->
                </h1>
                <p
                    id="level-description"
                    class="text-xl text-gray-300 max-w-2xl mx-auto"
                >
                    <!-- Injected via JS -->
                </p>
            </div>

            <!-- Analysis Card -->
            <div
                class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-8 text-left"
            >
                <h3 class="text-2xl font-bold mb-4 flex items-center gap-2">
                    <svg
                        class="w-6 h-6 text-[#00C49A]"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2z"
                        ></path>
                    </svg>
                    Análisis Inicial
                </h3>
                <p id="level-analysis" class="text-gray-300 leading-relaxed">
                    <!-- Injected via JS -->
                </p>
            </div>

            <!-- CTA Section (Monetization) -->
            <div
                id="cta-section"
                class="bg-gradient-to-br from-[#00C49A]/20 to-[#007BFF]/20 border border-[#00C49A]/30 rounded-2xl p-8 relative overflow-hidden group"
            >
                <div
                    class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity"
                >
                    <svg
                        class="w-32 h-32 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1"
                            d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                </div>

                <h3
                    id="cta-title"
                    class="text-2xl font-bold text-white mb-2 relative z-10"
                >
                    <!-- Injected via JS -->
                </h3>
                <p id="cta-desc" class="text-gray-200 mb-6 relative z-10">
                    <!-- Injected via JS -->
                </p>

                <div
                    id="cta-buttons"
                    class="flex flex-col sm:flex-row gap-4 justify-center relative z-10"
                >
                    <!-- Injected via JS -->
                </div>
            </div>
        </div>

        <!-- Loading State -->
        <div id="loading" class="text-center">
            <div
                class="w-16 h-16 border-4 border-[#00C49A] border-t-transparent rounded-full animate-spin mx-auto mb-4"
            >
            </div>
            <p class="text-gray-400">Analizando tus respuestas...</p>
        </div>
    </div>
</Layout>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        // Simulator delay for realistic analysis feel
        setTimeout(() => {
            const scoreStr = sessionStorage.getItem("imr_score");
            const ffmiStr = sessionStorage.getItem("imr_ffmi") || "0";
            const ffmi = parseInt(ffmiStr);
            const interpretation = sessionStorage.getItem("imr_interpretation") || "Analizando tu estado metabólico...";
            const userName = sessionStorage.getItem("imr_userName") || "Sujeto";

            if (!scoreStr) {
                window.location.href = "/";
                return;
            }

            const loadingAPI = document.getElementById("loading");
            const resultContainer = document.getElementById("result-container");

            if (loadingAPI) loadingAPI.classList.add("hidden");
            if (resultContainer) resultContainer.classList.remove("hidden");

            // Populate Data
            const scoreValue = document.getElementById("score-value");
            const scoreCircle = document.getElementById("score-circle");
            const levelTitle = document.getElementById("level-title");
            const levelAnalysis = document.getElementById("level-analysis");
            const ctaTitle = document.getElementById("cta-title");
            const ctaDesc = document.getElementById("cta-desc");
            const ctaButtons = document.getElementById("cta-buttons");

            const score = parseInt(scoreStr);

            // Animation
            let currentScore = 0;
            const duration = 1500;
            const stepTime = Math.max(10, Math.abs(Math.floor(duration / score)));

            if (scoreValue) {
                const timer = setInterval(() => {
                    currentScore++;
                    scoreValue.innerText = currentScore.toString();
                    if (currentScore >= score) clearInterval(timer);
                }, stepTime);
            }

            // Circle Stroke Animation
            const circumference = 553;
            const offset = circumference - (score / 100) * circumference;
            if (scoreCircle) {
                scoreCircle.style.strokeDashoffset = offset.toString();
            }

            // Logic Levels
            if (score <= 40) {
                scoreCircle?.classList.add("text-red-500", "drop-shadow-[0_0_10px_rgba(239,68,68,0.5)]");
            } else if (score <= 70) {
                scoreCircle?.classList.add("text-yellow-400", "drop-shadow-[0_0_10px_rgba(250,204,21,0.5)]");
            } else {
                scoreCircle?.classList.add("text-[#00C49A]", "drop-shadow-[0_0_10px_rgba(0,196,154,0.5)]");
            }

            if (levelTitle) {
                levelTitle.innerHTML = `<span class="text-white">Análisis de Authority V2 para ${userName}</span>`;
            }

            if (levelAnalysis) {
                levelAnalysis.innerHTML = `
                    <div class="space-y-4">
                        <p class="text-xl font-bold text-[#00C49A]">Interpretación: ${interpretation}</p>
                        <div class="bg-black/40 p-6 rounded-2xl border border-white/10 shadow-inner">
                            <div class="flex justify-between items-end mb-2">
                                <div>
                                    <span class="text-xs text-gray-400 uppercase tracking-widest font-bold">Motor Metabólico (FFMI)</span>
                                    <div class="text-3xl font-black text-white" id="ffmi-display">${ffmiStr} <span class="text-sm font-normal text-gray-400">pts</span></div>
                                </div>
                                <div id="ffmi-label" class="text-xs font-bold px-3 py-1 rounded-full border mb-1 border-white/20 bg-white/5">
                                    ${ffmi < 18 ? "Funcional" : ffmi < 21 ? "Atlético" : "Elite"}
                                </div>
                            </div>
                            
                            <!-- Clinical Range Bar -->
                            <div class="w-full bg-gray-800 h-2 rounded-full overflow-hidden flex mb-2">
                                <div id="ffmi-bar" class="h-full transition-all duration-1000 ease-out bg-gradient-to-r from-red-500 via-[#00C49A] to-blue-500" style="width: ${Math.min(ffmi * 4, 100)}%"></div>
                            </div>
                            <div class="flex justify-between text-[10px] text-gray-500 font-mono uppercase">
                                <span>Crítico</span>
                                <span>Funcional</span>
                                <span>Atlético</span>
                                <span>Elite</span>
                            </div>
                        </div>
                        
                        <div id="ffmi-insight" class="text-sm text-gray-400 italic bg-white/5 p-3 rounded-lg border-l-2 border-[#00C49A]">
                            Tu nivel actual sugiere una respuesta adaptativa de tipo ${ffmi < 19 ? "básica" : "avanzada"}.
                        </div>
                        <p class="text-gray-300 leading-relaxed">
                            Tu Índice Metamorfosis Real (IMR) ha sido validado por el motor central. 
                            La relación entre tu cuello, cintura y FFMI indica que necesitas una reparación estructural.
                        </p>
                    </div>
                `;
            }

            if (ctaTitle) ctaTitle.innerText = "Acceso a ElenaApp: Lista de Espera Privada";
            if (ctaDesc) ctaDesc.innerText = "Tu diagnóstico ha sido sincronizado. Te notificaremos por correo para el programa piloto de optimización de FFMI.";
            
            if (ctaButtons) {
                ctaButtons.innerHTML = `
                    <a href="/" class="inline-flex items-center justify-center px-8 py-3 text-sm font-bold text-[#00C49A] hover:bg-[#00C49A]/10 border border-[#00C49A]/50 rounded-xl transition-all w-full sm:w-auto">
                        Volver al Inicio
                    </a>
                `;
            }
        }, 800);
    });
</script>
