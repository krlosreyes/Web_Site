---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Acceso Exclusivo | Metamorfosis Real">
  <main class="min-h-screen bg-[#020408] flex items-center justify-center px-4 relative overflow-hidden">
    {/* Fondos Bio-Tech */}
    <div class="absolute top-[-20%] left-[-10%] w-[60%] h-[60%] bg-blue-600/10 blur-[150px] rounded-full"></div>
    <div class="absolute bottom-[-20%] right-[-10%] w-[60%] h-[60%] bg-[#00C49A]/10 blur-[150px] rounded-full"></div>

    <div class="w-full max-w-[450px] relative z-10 py-12">
      <div class="text-center mb-10 animate-fade-in">
        <img src="/logoSite.png" alt="IMR Logo" class="h-20 w-auto mx-auto mb-6 drop-shadow-[0_0_25px_rgba(59,130,246,0.4)]" />
        <h1 id="portal-title" class="text-4xl font-black text-white italic uppercase tracking-tighter leading-none">
            Acceso <span class="text-blue-500 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-blue-600">Premium</span>
        </h1>
        <p id="portal-subtitle" class="mt-3 text-gray-500 text-[9px] font-black uppercase tracking-[0.3em] opacity-70">Sincronización de Identidad Metabólica</p>
      </div>

      <div class="bg-white/5 p-1 rounded-2xl mb-8 flex border border-white/10 backdrop-blur-md relative">
        <button id="tab-login" class="flex-1 py-3 text-[10px] font-black uppercase tracking-widest rounded-xl transition-all bg-blue-600 text-white shadow-lg">Iniciar Sesión</button>
        <button id="tab-register" class="flex-1 py-3 text-[10px] font-black uppercase tracking-widest rounded-xl transition-all text-gray-600 relative group">
            Crear Perfil <span id="lock-icon" class="ml-2">🔒</span>
        </button>
      </div>

      <div id="merit-alert" class="hidden mb-6 p-4 rounded-2xl bg-red-600/10 border border-red-500/20 text-center">
        <p class="text-[10px] font-black text-red-400 uppercase tracking-widest leading-relaxed">
            Debes calcular tu IMR o leer un artículo para habilitar tu registro.
        </p>
      </div>

      <div class="bg-white/[0.03] backdrop-blur-[30px] border border-white/10 p-10 rounded-[3rem] shadow-2xl">
        <form id="auth-form" class="space-y-6">
          <div id="field-name" class="hidden space-y-2">
            <label class="text-[10px] font-black text-blue-400 uppercase tracking-widest ml-1">Nombre Biohacker</label>
            <input id="input-name" type="text" placeholder="Tu nombre real..." class="w-full bg-black/40 border border-white/5 rounded-2xl py-4 px-6 text-white text-sm outline-none focus:border-blue-500/50 transition-all" />
          </div>

          <div class="space-y-2">
            <label class="text-[10px] font-black text-blue-400 uppercase tracking-widest ml-1">Email</label>
            <input id="input-email" type="email" placeholder="tu@metamorfosis.com" required class="w-full bg-black/40 border border-white/5 rounded-2xl py-4 px-6 text-white text-sm outline-none focus:border-blue-500/50 transition-all" />
          </div>
          
          <div class="space-y-2">
            <label class="text-[10px] font-black text-blue-400 uppercase tracking-widest ml-1">Clave</label>
            <input id="input-pass" type="password" placeholder="••••••••••••" required class="w-full bg-black/40 border border-white/5 rounded-2xl py-4 px-6 text-white text-sm outline-none focus:border-blue-500/50 transition-all" />
          </div>

          <div class="pt-6">
            <button type="submit" id="submit-btn" class="w-full bg-blue-600 hover:bg-blue-500 text-white py-4 rounded-2xl font-black text-xs uppercase tracking-[0.3em] transition-all shadow-xl shadow-blue-600/20">
              Sincronizar Perfil
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
</Layout>

<script>
    import { auth, db } from '../lib/firebase';
    import { signInWithEmailAndPassword, createUserWithEmailAndPassword, updateProfile } from 'firebase/auth';
    import { doc, setDoc, getDoc } from 'firebase/firestore';

    const tabLogin = document.getElementById('tab-login');
    const tabRegister = document.getElementById('tab-register');
    const fieldName = document.getElementById('field-name');
    const inputName = document.getElementById('input-name');
    const inputEmail = document.getElementById('input-email');
    const inputPass = document.getElementById('input-pass');
    const submitBtn = document.getElementById('submit-btn');
    const meritAlert = document.getElementById('merit-alert');
    const lockIcon = document.getElementById('lock-icon');

    const hasIMR = !!sessionStorage.getItem('imr_score');
    const hasRead = localStorage.getItem('imr_article_read') === 'true';
    const isEligible = hasIMR || hasRead;

    let mode = 'login';

    const setMode = (newMode) => {
        if (newMode === 'register' && !isEligible) {
            meritAlert.classList.remove('hidden');
            setTimeout(() => meritAlert.classList.add('hidden'), 5000);
            return;
        }
        mode = newMode;
        if (mode === 'login') {
            tabLogin.classList.add('bg-blue-600', 'text-white');
            tabRegister.classList.remove('bg-blue-600', 'text-white');
            fieldName.classList.add('hidden');
            submitBtn.textContent = 'Sincronizar Perfil';
        } else {
            tabRegister.classList.add('bg-blue-600', 'text-white');
            tabLogin.classList.remove('bg-blue-600', 'text-white');
            fieldName.classList.remove('hidden');
            submitBtn.textContent = 'Crear Identidad';
        }
    };

    if (isEligible && lockIcon) lockIcon.textContent = '✅';
    tabLogin.addEventListener('click', () => setMode('login'));
    tabRegister.addEventListener('click', () => setMode('register'));

    document.getElementById('auth-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        submitBtn.textContent = 'Procesando...';
        submitBtn.disabled = true;

        const email = inputEmail.value.trim();
        const password = inputPass.value.trim();
        const nameInput = inputName.value.trim();

        try {
            if (mode === 'register') {
                const userCredential = await createUserWithEmailAndPassword(auth, email, password);
                await updateProfile(userCredential.user, { displayName: nameInput });

                // TODO(SPEC-006): reemplazar por POST /api/users/onboard que crea
                // users/{uid} con el schema canónico (UserDoc v1) y mergea cualquier
                // lead anónimo previo. La colección 'profiles' va a ser eliminada
                // por SPEC-005.3 (script de migración).
                const profileRef = doc(db, 'profiles', email.toLowerCase());
                await setDoc(profileRef, {
                    userName: nameInput,
                    email: email.toLowerCase(),
                    imr: parseInt(sessionStorage.getItem('imr_score') || '0'),
                    interpretation: sessionStorage.getItem('imr_interpretation') || 'Estado Inicial',
                    updatedAt: new Date().toISOString()
                });
                sessionStorage.setItem('imr_userName', nameInput);
            } else {
                const userCredential = await signInWithEmailAndPassword(auth, email, password);
                // TODO(SPEC-005.4): leer users/{uid} en lugar de profiles/{email}.
                const profileRef = doc(db, 'profiles', email.toLowerCase());
                const profileSnap = await getDoc(profileRef);
                if (profileSnap.exists()) {
                    const data = profileSnap.data();
                    sessionStorage.setItem('imr_userName', data.userName);
                    sessionStorage.setItem('imr_score', data.imr.toString());
                }
            }

            sessionStorage.setItem('user_email', email);
            window.location.href = '/dashboard';
        } catch (error) {
            alert("Error: " + error.message);
            submitBtn.textContent = mode === 'login' ? 'Sincronizar Perfil' : 'Crear Identidad';
            submitBtn.disabled = false;
        }
    });
</script>
