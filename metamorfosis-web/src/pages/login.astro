---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Acceso Exclusivo | Metamorfosis Real">
  <main class="min-h-screen bg-[#020408] flex items-center justify-center px-4 relative overflow-hidden">
    {/* Fondos Bio-Tech */}
    <div class="absolute top-[-20%] left-[-10%] w-[60%] h-[60%] bg-blue-600/10 blur-[150px] rounded-full"></div>
    <div class="absolute bottom-[-20%] right-[-10%] w-[60%] h-[60%] bg-[#00C49A]/10 blur-[150px] rounded-full"></div>

    <div class="w-full max-w-[450px] relative z-10 py-12">
      <div class="text-center mb-10 animate-fade-in">
        <img src="/logoSite.webp" alt="IMR Logo" width="80" height="80" class="h-20 w-auto mx-auto mb-6 drop-shadow-[0_0_25px_rgba(59,130,246,0.4)]" />
        <h1 id="portal-title" class="text-4xl font-black text-white italic uppercase tracking-tighter leading-none">
            Acceso <span class="text-blue-500 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-blue-600">Premium</span>
        </h1>
        <p id="portal-subtitle" class="mt-3 text-gray-500 text-[9px] font-black uppercase tracking-[0.3em] opacity-70">Sincronización de Identidad Metabólica</p>
      </div>

      <div class="bg-white/5 p-1 rounded-2xl mb-8 flex border border-white/10 backdrop-blur-md relative">
        <button id="tab-login" class="flex-1 py-3 text-[10px] font-black uppercase tracking-widest rounded-xl transition-all bg-blue-600 text-white shadow-lg">Iniciar Sesión</button>
        <button id="tab-register" class="flex-1 py-3 text-[10px] font-black uppercase tracking-widest rounded-xl transition-all text-gray-600 relative group">
            Crear Perfil <span id="lock-icon" class="ml-2">🔒</span>
        </button>
      </div>

      {/* SPEC-034: hint persistente con dos estados (no-elegible amber / elegible verde).
          Reemplaza al alert rojo agresivo. CTAs directos a /quiz y /biblioteca. */}
      <div id="onboarding-hint-pending" class="hidden mb-6 p-5 rounded-2xl bg-amber-500/8 border border-amber-500/30 text-left transition-all">
        <p class="text-sm text-amber-100 leading-relaxed mb-1">
            <span class="text-base">🌱</span> <strong>¿Primera vez por acá?</strong>
        </p>
        <p class="text-xs text-amber-100/80 leading-relaxed mb-4">
            Para mantener la calidad de La Tribu, antes de crear tu cuenta necesitamos que vivas el contenido. Elegí cualquiera de los dos:
        </p>
        <div class="flex flex-col sm:flex-row gap-2">
            <a href="/quiz" class="flex-1 text-center bg-blue-600/20 border border-blue-500/40 text-blue-200 hover:bg-blue-600/30 transition-all px-4 py-3 rounded-xl text-[11px] font-black uppercase tracking-widest">
                🧬 Calcular mi IMR · 2 min
            </a>
            <a href="/biblioteca" class="flex-1 text-center bg-[#00C49A]/20 border border-[#00C49A]/40 text-[#00C49A] hover:bg-[#00C49A]/30 transition-all px-4 py-3 rounded-xl text-[11px] font-black uppercase tracking-widest">
                📖 Artículo + test
            </a>
        </div>
        <p class="text-[10px] text-amber-200/50 font-mono uppercase tracking-widest mt-3">
            * El test al final del artículo es lo que habilita el registro
        </p>
      </div>

      <div id="onboarding-hint-ready" class="hidden mb-6 p-4 rounded-2xl bg-[#00C49A]/8 border border-[#00C49A]/30 text-center transition-all">
        <p class="text-xs text-[#00C49A] font-bold leading-relaxed">
            ✅ Listo: ya podés crear tu cuenta.
        </p>
      </div>

      <div class="bg-white/[0.03] backdrop-blur-[30px] border border-white/10 p-10 rounded-[3rem] shadow-2xl">
        <form id="auth-form" class="space-y-6">
          <div id="field-name" class="hidden space-y-2">
            <label class="text-[10px] font-black text-blue-400 uppercase tracking-widest ml-1">Nombre Biohacker</label>
            <input id="input-name" type="text" placeholder="Tu nombre real..." class="w-full bg-black/40 border border-white/5 rounded-2xl py-4 px-6 text-white text-sm outline-none focus:border-blue-500/50 transition-all" />
          </div>

          <div class="space-y-2">
            <label class="text-[10px] font-black text-blue-400 uppercase tracking-widest ml-1">Email</label>
            <input id="input-email" type="email" placeholder="tu@metamorfosis.com" required class="w-full bg-black/40 border border-white/5 rounded-2xl py-4 px-6 text-white text-sm outline-none focus:border-blue-500/50 transition-all" />
          </div>
          
          <div class="space-y-2">
            <label class="text-[10px] font-black text-blue-400 uppercase tracking-widest ml-1">Clave</label>
            <input id="input-pass" type="password" placeholder="••••••••••••" required class="w-full bg-black/40 border border-white/5 rounded-2xl py-4 px-6 text-white text-sm outline-none focus:border-blue-500/50 transition-all" />
          </div>

          <div class="pt-6">
            <button type="submit" id="submit-btn" class="w-full bg-blue-600 hover:bg-blue-500 text-white py-4 rounded-2xl font-black text-xs uppercase tracking-[0.3em] transition-all shadow-xl shadow-blue-600/20">
              Sincronizar Perfil
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
</Layout>

<script>
    import { auth, db } from '../lib/firebase';
    import { signInWithEmailAndPassword, createUserWithEmailAndPassword, updateProfile } from 'firebase/auth';
    import { doc, setDoc, arrayUnion } from 'firebase/firestore';
    import { COLLECTIONS } from '../lib/constants/firestore';

    const tabLogin = document.getElementById('tab-login');
    const tabRegister = document.getElementById('tab-register');
    const fieldName = document.getElementById('field-name');
    const inputName = document.getElementById('input-name');
    const inputEmail = document.getElementById('input-email');
    const inputPass = document.getElementById('input-pass');
    const submitBtn = document.getElementById('submit-btn');
    const hintPending = document.getElementById('onboarding-hint-pending');
    const hintReady = document.getElementById('onboarding-hint-ready');
    const lockIcon = document.getElementById('lock-icon');

    const QUIZ_STORAGE_KEY = 'imr_quiz_payload';

    const hasIMR = !!sessionStorage.getItem('imr_score');
    const hasRead = localStorage.getItem('imr_article_read') === 'true';
    const isEligible = hasIMR || hasRead;

    // SPEC-034: mostrar el hint apropiado desde el primer paint
    if (isEligible) {
        hintReady?.classList.remove('hidden');
    } else {
        hintPending?.classList.remove('hidden');
    }

    let mode = 'login';

    const setMode = (newMode) => {
        if (newMode === 'register' && !isEligible) {
            // SPEC-034: pulse del hint en lugar de alert pop-up
            if (hintPending) {
                hintPending.classList.add('ring-2', 'ring-amber-400/70', 'shadow-lg', 'shadow-amber-500/20');
                setTimeout(() => {
                    hintPending.classList.remove('ring-2', 'ring-amber-400/70', 'shadow-lg', 'shadow-amber-500/20');
                }, 1500);
                hintPending.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            return;
        }
        mode = newMode;
        if (mode === 'login') {
            tabLogin?.classList.add('bg-blue-600', 'text-white');
            tabRegister?.classList.remove('bg-blue-600', 'text-white');
            fieldName?.classList.add('hidden');
            if (submitBtn) submitBtn.textContent = 'Sincronizar Perfil';
        } else {
            tabRegister?.classList.add('bg-blue-600', 'text-white');
            tabLogin?.classList.remove('bg-blue-600', 'text-white');
            fieldName?.classList.remove('hidden');
            if (submitBtn) submitBtn.textContent = 'Crear Identidad';
        }
    };

    if (isEligible && lockIcon) lockIcon.textContent = '✅';
    tabLogin?.addEventListener('click', () => setMode('login'));
    tabRegister?.addEventListener('click', () => setMode('register'));

    /**
     * Llama a POST /api/users/onboard con el ID token para persistir el doc
     * users/{uid} con el schema canónico v1. Idempotente: si el user ya existe,
     * mergea sin duplicar.
     */
    async function onboardUser(user, payload) {
        const idToken = await user.getIdToken();
        const res = await fetch('/api/users/onboard', {
            method: 'POST',
            credentials: 'include',
            headers: {
                'Content-Type': 'application/json',
                Authorization: 'Bearer ' + idToken,
            },
            body: JSON.stringify(payload || {}),
        });
        if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            throw new Error(data.error || 'Onboard failed: ' + res.status);
        }
    }

    /**
     * SPEC-024: si el visitante completó un quiz como anónimo antes de
     * registrarse/loguearse, persiste el resultado en su perfil. Best-effort:
     * si falla por rules o red, el redirect al dashboard sigue. Vale tanto
     * para register (cuenta nueva) como login (volver a entrar).
     */
    async function flushPendingQuiz(user) {
        try {
            const raw = sessionStorage.getItem('imr_pending_quiz');
            if (!raw) return;
            const quiz = JSON.parse(raw);
            if (!quiz?.articleId) return;
            const userRef = doc(db, COLLECTIONS.USERS, user.uid);
            await setDoc(userRef, {
                completedQuizzes: arrayUnion({
                    articleId: quiz.articleId,
                    score: quiz.percentage,
                    date: quiz.date,
                }),
            }, { merge: true });
            sessionStorage.removeItem('imr_pending_quiz');
        } catch (err) {
            // Best-effort: el redirect sigue aunque la persistencia falle.
            console.error('[login] flushPendingQuiz error:', err);
        }
    }

    /**
     * Lee el doc canónico via /api/users/me para popular sessionStorage con
     * userName + imr_score (que el resto de la UI consume).
     */
    async function syncSessionFromServer(user) {
        const idToken = await user.getIdToken();
        const res = await fetch('/api/users/me', {
            headers: { Authorization: 'Bearer ' + idToken },
        });
        if (res.ok) {
            const { user: doc } = await res.json();
            if (doc?.displayName) sessionStorage.setItem('imr_userName', doc.displayName);
            if (doc?.imr?.current?.imrScore != null) {
                sessionStorage.setItem('imr_score', String(doc.imr.current.imrScore));
            }
            if (doc?.imr?.current?.label) {
                sessionStorage.setItem('imr_label', doc.imr.current.label);
            }
        }
    }

    document.getElementById('auth-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (submitBtn) {
            submitBtn.textContent = 'Procesando...';
            submitBtn.disabled = true;
        }

        const email = inputEmail.value.trim();
        const password = inputPass.value.trim();
        const nameInput = inputName.value.trim();

        try {
            if (mode === 'register') {
                const userCredential = await createUserWithEmailAndPassword(auth, email, password);
                await updateProfile(userCredential.user, { displayName: nameInput });

                // Si el visitante hizo el quiz antes de registrarse, recuperamos
                // el payload completo de sessionStorage. Si entró directo al
                // login sin quiz, el payload va vacío y el doc se crea con
                // bio/habits nulls; el user puede completar luego desde /quiz.
                const stored = sessionStorage.getItem(QUIZ_STORAGE_KEY);
                const payload = stored ? JSON.parse(stored) : {};

                // SPEC-029b: pasar displayName explícito al backend.
                // El ID token recién emitido NO refleja todavía el updateProfile
                // anterior, así que decoded.name viene vacío server-side.
                payload.displayName = nameInput;

                await onboardUser(userCredential.user, payload);
                sessionStorage.removeItem(QUIZ_STORAGE_KEY);
                sessionStorage.setItem('imr_userName', nameInput);
                // SPEC-024: persistir quiz pendiente del anónimo en su nuevo perfil
                await flushPendingQuiz(userCredential.user);
            } else {
                const userCredential = await signInWithEmailAndPassword(auth, email, password);
                await syncSessionFromServer(userCredential.user);
                // SPEC-024: si volvió como anónimo, completó un quiz nuevo y
                // ahora se loguea, también persistimos
                await flushPendingQuiz(userCredential.user);
            }

            sessionStorage.setItem('user_email', email);
            window.location.href = '/dashboard';
        } catch (error) {
            alert("Error: " + error.message);
            if (submitBtn) {
                submitBtn.textContent = mode === 'login' ? 'Sincronizar Perfil' : 'Crear Identidad';
                submitBtn.disabled = false;
            }
        }
    });
</script>
