---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Acceso">
  <main class="min-h-screen bg-bg-base flex items-center justify-center px-4">
    <div class="w-full max-w-[420px] relative z-10 py-12">
      <div class="text-center mb-8">
        <img src="/logoSite.webp" alt="Metamorfosis Real" width="64" height="64" class="h-16 w-auto mx-auto mb-5 drop-shadow-[0_0_20px_rgba(0,196,154,0.35)]" />
        <h1 id="portal-title" class="text-3xl md:text-4xl font-black text-text-primary italic uppercase tracking-tight leading-tight">
            Acceso <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00C49A] to-emerald-400">Premium</span>
        </h1>
        <p id="portal-subtitle" class="mt-3 text-[11px] font-bold text-text-muted uppercase tracking-[0.2em]">Tu identidad metabólica</p>
      </div>

      <!-- Tabs Login/Registro -->
      <div class="bg-bg-elevated p-1 rounded-lg mb-6 flex border border-white/[0.08]">
        <button id="tab-login" class="flex-1 py-2.5 text-xs font-semibold rounded-md transition-colors bg-accent text-bg-base">
          Iniciar sesión
        </button>
        <button id="tab-register" class="flex-1 py-2.5 text-xs font-semibold rounded-md transition-colors text-text-muted">
          Crear perfil <span id="lock-icon" class="ml-1">🔒</span>
        </button>
      </div>

      <!-- Hint estado: pendiente (no completó quiz ni leyó artículo) -->
      <div id="onboarding-hint-pending" class="hidden mb-5 p-4 rounded-xl bg-status-warn/[0.08] border border-status-warn/30 text-left">
        <p class="text-sm text-text-primary leading-relaxed mb-1">
            <span class="text-base">🌱</span> <strong>¿Primera vez por acá?</strong>
        </p>
        <p class="text-xs text-text-secondary leading-relaxed mb-3">
            Para mantener la calidad de La Tribu, antes de crear tu cuenta necesitamos que vivas el contenido. Elige cualquiera de los dos:
        </p>
        <div class="flex flex-col sm:flex-row gap-2">
            <a href="/quiz" class="flex-1 text-center bg-bg-surface border border-white/[0.1] text-text-primary hover:border-accent/40 transition-colors px-3 py-2.5 rounded-lg text-xs font-semibold">
                🧬 Calcular mi IMR · 2 min
            </a>
            <a href="/biblioteca" class="flex-1 text-center bg-bg-surface border border-white/[0.1] text-text-primary hover:border-accent/40 transition-colors px-3 py-2.5 rounded-lg text-xs font-semibold">
                📖 Artículo + quiz
            </a>
        </div>
        <p class="text-[11px] text-text-muted mt-3">
            * El quiz al final del artículo habilita el registro.
        </p>
      </div>

      <!-- Hint estado: listo (completó algo) -->
      <div id="onboarding-hint-ready" class="hidden mb-5 p-3 rounded-lg bg-accent/[0.08] border border-accent/30 text-center">
        <p class="text-sm text-accent font-semibold">
            ✅ Listo: ya puedes crear tu cuenta.
        </p>
      </div>

      <!-- Form auth -->
      <div class="bg-bg-elevated border border-white/[0.1] p-6 md:p-8 rounded-xl">
        <form id="auth-form" class="space-y-4">
          <div id="field-name" class="hidden space-y-1.5">
            <label class="text-[11px] font-bold text-text-muted uppercase tracking-[0.18em] ml-1">Tu nombre</label>
            <input id="input-name" type="text" placeholder="Tu nombre" class="w-full bg-bg-base/60 border border-white/[0.08] rounded-lg py-3 px-4 text-text-primary text-base outline-none focus:border-accent transition-colors placeholder:text-text-muted" />
          </div>

          <div class="space-y-1.5">
            <label class="text-[11px] font-bold text-text-muted uppercase tracking-[0.18em] ml-1">Email</label>
            <input id="input-email" type="email" placeholder="tu@email.com" required class="w-full bg-bg-base/60 border border-white/[0.08] rounded-lg py-3 px-4 text-text-primary text-base outline-none focus:border-accent transition-colors placeholder:text-text-muted" />
          </div>

          <div class="space-y-1.5">
            <label class="text-[11px] font-bold text-text-muted uppercase tracking-[0.18em] ml-1">Contraseña</label>
            <input id="input-pass" type="password" placeholder="••••••••••••" required class="w-full bg-bg-base/60 border border-white/[0.08] rounded-lg py-3 px-4 text-text-primary text-base outline-none focus:border-accent transition-colors placeholder:text-text-muted" />
          </div>

          <div class="pt-3">
            <button type="submit" id="submit-btn" class="w-full bg-accent hover:bg-accent-strong disabled:bg-bg-surface disabled:text-text-muted text-bg-base py-3 rounded-lg font-semibold text-base transition-colors">
              Entrar
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
</Layout>

<script>
    import { auth, db } from '../lib/firebase';
    import { signInWithEmailAndPassword, createUserWithEmailAndPassword, updateProfile } from 'firebase/auth';
    import { doc, setDoc, arrayUnion } from 'firebase/firestore';
    import { COLLECTIONS } from '../lib/constants/firestore';

    const tabLogin = document.getElementById('tab-login');
    const tabRegister = document.getElementById('tab-register');
    const fieldName = document.getElementById('field-name');
    const inputName = document.getElementById('input-name');
    const inputEmail = document.getElementById('input-email');
    const inputPass = document.getElementById('input-pass');
    const submitBtn = document.getElementById('submit-btn');
    const hintPending = document.getElementById('onboarding-hint-pending');
    const hintReady = document.getElementById('onboarding-hint-ready');
    const lockIcon = document.getElementById('lock-icon');

    const QUIZ_STORAGE_KEY = 'imr_quiz_payload';

    const hasIMR = !!sessionStorage.getItem('imr_score');
    const hasRead = localStorage.getItem('imr_article_read') === 'true';
    const isEligible = hasIMR || hasRead;

    // SPEC-034: mostrar el hint apropiado desde el primer paint
    if (isEligible) {
        hintReady?.classList.remove('hidden');
    } else {
        hintPending?.classList.remove('hidden');
    }

    let mode = 'login';

    const setMode = (newMode) => {
        if (newMode === 'register' && !isEligible) {
            // SPEC-034: pulse del hint en lugar de alert pop-up
            if (hintPending) {
                hintPending.classList.add('ring-2', 'ring-amber-400/70', 'shadow-lg', 'shadow-amber-500/20');
                setTimeout(() => {
                    hintPending.classList.remove('ring-2', 'ring-amber-400/70', 'shadow-lg', 'shadow-amber-500/20');
                }, 1500);
                hintPending.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            return;
        }
        mode = newMode;
        if (mode === 'login') {
            tabLogin?.classList.add('bg-accent', 'text-bg-base');
            tabLogin?.classList.remove('text-text-muted');
            tabRegister?.classList.remove('bg-accent', 'text-bg-base');
            tabRegister?.classList.add('text-text-muted');
            fieldName?.classList.add('hidden');
            if (submitBtn) submitBtn.textContent = 'Entrar';
        } else {
            tabRegister?.classList.add('bg-accent', 'text-bg-base');
            tabRegister?.classList.remove('text-text-muted');
            tabLogin?.classList.remove('bg-accent', 'text-bg-base');
            tabLogin?.classList.add('text-text-muted');
            fieldName?.classList.remove('hidden');
            if (submitBtn) submitBtn.textContent = 'Crear cuenta';
        }
    };

    if (isEligible && lockIcon) lockIcon.textContent = '✅';
    tabLogin?.addEventListener('click', () => setMode('login'));
    tabRegister?.addEventListener('click', () => setMode('register'));

    /**
     * Llama a POST /api/users/onboard con el ID token para persistir el doc
     * users/{uid} con el schema canónico v1. Idempotente: si el user ya existe,
     * mergea sin duplicar.
     */
    async function onboardUser(user, payload) {
        const idToken = await user.getIdToken();
        const res = await fetch('/api/users/onboard', {
            method: 'POST',
            credentials: 'include',
            headers: {
                'Content-Type': 'application/json',
                Authorization: 'Bearer ' + idToken,
            },
            body: JSON.stringify(payload || {}),
        });
        if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            throw new Error(data.error || 'Onboard failed: ' + res.status);
        }
    }

    /**
     * SPEC-024: si el visitante completó un quiz como anónimo antes de
     * registrarse/loguearse, persiste el resultado en su perfil. Best-effort:
     * si falla por rules o red, el redirect al dashboard sigue. Vale tanto
     * para register (cuenta nueva) como login (volver a entrar).
     */
    async function flushPendingQuiz(user) {
        try {
            const raw = sessionStorage.getItem('imr_pending_quiz');
            if (!raw) return;
            const quiz = JSON.parse(raw);
            if (!quiz?.articleId) return;
            const userRef = doc(db, COLLECTIONS.USERS, user.uid);
            await setDoc(userRef, {
                completedQuizzes: arrayUnion({
                    articleId: quiz.articleId,
                    score: quiz.percentage,
                    date: quiz.date,
                }),
            }, { merge: true });
            sessionStorage.removeItem('imr_pending_quiz');
        } catch (err) {
            // Best-effort: el redirect sigue aunque la persistencia falle.
            console.error('[login] flushPendingQuiz error:', err);
        }
    }

    /**
     * Lee el doc canónico via /api/users/me para popular sessionStorage con
     * userName + imr_score (que el resto de la UI consume).
     */
    async function syncSessionFromServer(user) {
        const idToken = await user.getIdToken();
        const res = await fetch('/api/users/me', {
            headers: { Authorization: 'Bearer ' + idToken },
        });
        if (res.ok) {
            const { user: doc } = await res.json();
            if (doc?.displayName) sessionStorage.setItem('imr_userName', doc.displayName);
            if (doc?.imr?.current?.imrScore != null) {
                sessionStorage.setItem('imr_score', String(doc.imr.current.imrScore));
            }
            if (doc?.imr?.current?.label) {
                sessionStorage.setItem('imr_label', doc.imr.current.label);
            }
        }
    }

    document.getElementById('auth-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (submitBtn) {
            submitBtn.textContent = 'Procesando...';
            submitBtn.disabled = true;
        }

        const email = inputEmail.value.trim();
        const password = inputPass.value.trim();
        const nameInput = inputName.value.trim();

        try {
            if (mode === 'register') {
                const userCredential = await createUserWithEmailAndPassword(auth, email, password);
                await updateProfile(userCredential.user, { displayName: nameInput });

                // Si el visitante hizo el quiz antes de registrarse, recuperamos
                // el payload completo de sessionStorage. Si entró directo al
                // login sin quiz, el payload va vacío y el doc se crea con
                // bio/habits nulls; el user puede completar luego desde /quiz.
                const stored = sessionStorage.getItem(QUIZ_STORAGE_KEY);
                const payload = stored ? JSON.parse(stored) : {};

                // SPEC-029b: pasar displayName explícito al backend.
                // El ID token recién emitido NO refleja todavía el updateProfile
                // anterior, así que decoded.name viene vacío server-side.
                payload.displayName = nameInput;

                await onboardUser(userCredential.user, payload);
                sessionStorage.removeItem(QUIZ_STORAGE_KEY);
                sessionStorage.setItem('imr_userName', nameInput);
                // SPEC-024: persistir quiz pendiente del anónimo en su nuevo perfil
                await flushPendingQuiz(userCredential.user);
            } else {
                const userCredential = await signInWithEmailAndPassword(auth, email, password);
                await syncSessionFromServer(userCredential.user);
                // SPEC-024: si volvió como anónimo, completó un quiz nuevo y
                // ahora se loguea, también persistimos
                await flushPendingQuiz(userCredential.user);
            }

            sessionStorage.setItem('user_email', email);
            window.location.href = '/dashboard';
        } catch (error) {
            alert("Error: " + error.message);
            if (submitBtn) {
                submitBtn.textContent = mode === 'login' ? 'Sincronizar Perfil' : 'Crear Identidad';
                submitBtn.disabled = false;
            }
        }
    });
</script>
