---
/**
 * SPEC-117 (26-nov-2026): reemplaza a /sobre-mi. El sitio deja de mostrar el
 * nombre, la foto, la edad y la historia de salud personal del fundador; la
 * página habla del proyecto. /sobre-mi redirige aquí con 301.
 * Las páginas legales sí conservan el nombre del responsable (Ley 1581).
 */
import Layout from "../layouts/Layout.astro";
import AppStoreButton from "../components/AppStoreButton.astro";
---

<Layout
    title="Sobre nosotros"
    description="Metamorfosis Real es un proyecto colombiano de salud metabólica: contenido con fuentes verificables, el índice IMR y la app Elena."
>
    <section
        class="relative h-[50vh] min-h-[360px] flex items-center overflow-hidden bg-bg-base"
    >
        <div
            class="absolute inset-0 z-0 bg-cover bg-center opacity-30"
            style="background-image: url('https://images.unsplash.com/photo-1544367563-12123d8965cd?auto=format&fit=crop&q=80&w=1920');"
        >
        </div>
        <div
            class="absolute inset-0 z-[1] bg-gradient-to-t from-bg-base via-bg-base/40 to-transparent"
        >
        </div>
        <div
            class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 text-center"
        >
            <h1
                class="text-4xl sm:text-5xl lg:text-6xl font-heading font-black italic uppercase tracking-tight leading-tight text-text-primary mb-5 drop-shadow-lg"
            >
                Salud metabólica, <br class="hidden sm:block" />
                <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-[#00C49A] to-emerald-400"
                >
                    con ciencia verificable
                </span>
            </h1>
            <p
                class="text-lg sm:text-xl text-text-primary/90 max-w-2xl mx-auto leading-relaxed drop-shadow-md"
            >
                Te damos las herramientas. Tú creas los hábitos.
            </p>
        </div>
    </section>

    <section class="py-16 md:py-20 bg-bg-base">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-3xl">
            <h2 class="text-3xl md:text-4xl font-bold text-text-primary tracking-tight mb-4">
                Qué es Metamorfosis Real
            </h2>
            <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-amber-400 mb-5">
                No somos médicos ni reemplazamos una consulta
            </p>
            <div class="space-y-4 text-base md:text-lg leading-relaxed text-gray-300">
                <p>
                    Metamorfosis Real es un proyecto hecho en Colombia para ayudarte a
                    entender y mejorar tu
                    <strong class="text-text-primary font-semibold">salud metabólica</strong>
                    con cinco pilares: ayuno, alimentación, sueño, ejercicio e hidratación.
                </p>
                <p>
                    Tiene tres piezas: este sitio, con artículos y el
                    <a href="/imr" class="text-accent hover:underline">índice IMR</a>; el canal
                    de YouTube, con formación; y
                    <strong class="text-text-primary font-semibold">Elena</strong>, la app para
                    iPhone que reúne tu día metabólico en un solo puntaje.
                </p>
                <p>
                    Lo que publicamos se basa en literatura científica y guías clínicas
                    publicadas, y lo citamos para que puedas revisarlo. Si tienes una
                    condición de salud, tomas medicamentos o estás embarazada, consulta a tu
                    médico antes de cambiar tu alimentación o empezar a ayunar. Lee el
                    <a href="/disclaimer-medico" class="text-accent hover:underline">aviso médico</a>.
                </p>
            </div>
        </div>
    </section>

    <!-- Philosophy/Values Section -->
    <section class="py-16 md:py-20 bg-bg-base">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <p class="text-[11px] font-bold text-accent uppercase tracking-[0.2em] mb-3">Nuestro enfoque</p>
                <h2 class="text-3xl md:text-4xl font-bold text-text-primary tracking-tight mb-4">
                    Ingeniería aplicada
                </h2>
                <p class="text-lg text-gray-300 leading-relaxed">
                    No se trata de fuerza de voluntad, se trata de sistemas: hábitos medibles,
                    sostenidos en el tiempo y explicados con ciencia.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-5">
                <!-- Card 1 -->
                <div
                    class="bg-bg-elevated border border-white/[0.08] rounded-xl p-6 hover:border-accent/30 transition-colors"
                >
                    <div class="w-10 h-10 bg-accent/10 rounded-lg flex items-center justify-center mb-4 border border-accent/20">
                        <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2z"></path>
                        </svg>
                    </div>
                    <h3 class="text-base font-semibold text-text-primary tracking-tight mb-2">
                        Basado en datos
                    </h3>
                    <p class="text-sm text-gray-300 leading-relaxed">
                        Lo que no se mide, no se puede mejorar. Biomarcadores y seguimiento preciso
                        para tomar decisiones informadas, no adivinanzas.
                    </p>
                </div>

                <!-- Card 2 -->
                <div
                    class="bg-bg-elevated border border-white/[0.08] rounded-xl p-6 hover:border-accent/30 transition-colors"
                >
                    <div class="w-10 h-10 bg-accent/10 rounded-lg flex items-center justify-center mb-4 border border-accent/20">
                        <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
                        </svg>
                    </div>
                    <h3 class="text-base font-semibold text-text-primary tracking-tight mb-2">
                        Ciencia, no moda
                    </h3>
                    <p class="text-sm text-gray-300 leading-relaxed">
                        Nada de "dietas milagro". Lo que publicamos cita los estudios y guías en
                        los que se basa, para que puedas verificarlo.
                    </p>
                </div>

                <!-- Card 3 -->
                <div
                    class="bg-bg-elevated border border-white/[0.08] rounded-xl p-6 hover:border-accent/30 transition-colors"
                >
                    <div class="w-10 h-10 bg-accent/10 rounded-lg flex items-center justify-center mb-4 border border-accent/20">
                        <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <h3 class="text-base font-semibold text-text-primary tracking-tight mb-2">
                        Resultados sostenibles
                    </h3>
                    <p class="text-sm text-gray-300 leading-relaxed">
                        El objetivo no es un cambio rápido que dure una semana. Es construir un
                        estilo de vida que puedas mantener para siempre.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA/Mission Section — sin gradient halos blur. -->
    <section class="py-20 bg-bg-base">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl mx-auto text-center bg-bg-elevated border border-white/[0.1] rounded-xl p-8 md:p-12">
                <h2 class="text-3xl md:text-4xl font-bold text-text-primary tracking-tight mb-5">
                    ¿Listo para diseñar tu propia metamorfosis?
                </h2>
                <p class="text-base md:text-lg text-gray-300 mb-8 leading-relaxed">
                    Empieza por conocer tu IMR o descarga Elena para llevar tu día metabólico
                    paso a paso.
                </p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                    <a
                        href="/quiz"
                        class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-accent text-bg-base rounded-lg font-semibold text-base hover:bg-accent-strong transition-colors"
                    >
                        Comenzar ahora
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                        </svg>
                    </a>
                    <AppStoreButton source="sobre_nosotros" variant="secondary" label="Descargar Elena" />
                    <a
                        href="/biblioteca"
                        class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-bg-surface text-text-primary rounded-lg font-semibold text-base border border-white/[0.12] hover:bg-bg-surface/80 hover:border-white/[0.2] transition-colors"
                    >
                        Leer artículos
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>
