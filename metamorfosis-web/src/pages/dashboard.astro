---
import BaseLayout from '../layouts/BaseLayout.astro';
import BioDashboard from '../components/BioDashboard';
---

<BaseLayout title="Centro de Mando | Metamorfosis Real">
    <main class="min-h-screen bg-[#020408] relative overflow-hidden pt-8 pb-24">
        {/* Decoración Atmosférica Sutil */}
        <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-blue-600/5 blur-[120px] rounded-full -z-0"></div>
        <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-[#00C49A]/5 blur-[120px] rounded-full -z-0"></div>
        
        <div class="container mx-auto px-6 relative z-10">
            {/* El Dashboard maneja ahora su propio header dinámico */}
            <BioDashboard client:only="react" />
        </div>
    </main>
</BaseLayout>
