---
import BaseLayout from '../layouts/BaseLayout.astro';
import BioDashboard from '../components/BioDashboard';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
---

<BaseLayout title="Tu reporte IMR">
    {/* SPEC-026: pt-28 reserva 112px para no quedar tapados por el navbar fixed.
        SPEC-080: disclaimer médico compact al inicio del dashboard. El usuario
        ve su IMR — debe quedar claro que NO es diagnóstico clínico. */}
    <main class="min-h-screen bg-bg-base pt-28 pb-24">
        <div class="container mx-auto px-6">
            <div class="max-w-7xl mx-auto mb-6">
                <MedicalDisclaimer variant="compact" />
            </div>
            <BioDashboard client:only="react" />
        </div>
    </main>
</BaseLayout>
