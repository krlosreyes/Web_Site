---
import { Database, LayoutDashboard, Smartphone } from "lucide-astro";
import Hero from "../components/Hero.astro";
import Pillars from "../components/Pillars.astro";
import TipsBox from "../components/TipsBox.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// SPEC-079: title vacío en la home → BaseLayout muestra solo "Metamorfosis Real".
// Antes se concatenaba "Tu Metabolismo, Reiniciado | Metamorfosis Real | Metamorfosis Real".
const description =
  "Ecosistema de salud metabólica de alta autoridad. Optimiza tu biología con ciencia real y el motor de inteligencia de ElenaApp.";
---

<BaseLayout
  description={description}
  preloadImage="/header-bg.webp"
  preloadImageType="image/webp"
>
  <!-- HERO SECTION -->
  <Hero />

  <!-- METABOLIC PILLARS -->
  <Pillars />

  <!-- ELENA APP PREVIEW / CONVERSION SECTION — SPEC-078: migrado a system -->
  <section id="protocolos" class="py-20 md:py-24 px-6">
    <div class="container mx-auto max-w-5xl">
      <div
        class="bg-bg-elevated border border-white/[0.08] rounded-2xl p-6 md:p-10 grid md:grid-cols-2 gap-8 md:gap-12 items-center"
      >
        <div>
          <div
            class="flex items-center gap-2 text-accent text-[11px] font-bold uppercase tracking-[0.2em] mb-4"
          >
            <Smartphone size={14} />
            El próximo nivel: ElenaApp
          </div>
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-text-primary tracking-tight mb-5">
            Tu coach metabólico en tu bolsillo
          </h2>
          <p class="text-gray-300 text-base md:text-lg mb-7 leading-relaxed">
            Metamorfosis Real integra el motor de inteligencia de
            <span class="text-text-primary font-semibold">ElenaApp</span>
            para ofrecerte protocolos hiper-personalizados basados en tu IMR (Índice
            de Metamorfosis Real).
          </p>

          <ul class="space-y-3 mb-8">
            <li class="flex items-start gap-3">
              <div
                class="w-7 h-7 rounded-lg bg-accent/10 border border-accent/20 flex items-center justify-center text-accent mt-0.5 shrink-0"
              >
                <LayoutDashboard size={14} />
              </div>
              <p class="text-sm text-gray-300 leading-relaxed">
                <strong class="text-text-primary font-semibold">Dynamic Protocol Logging:</strong>
                tu dieta cambia en tiempo real según tu bio-feedback diario.
              </p>
            </li>
            <li class="flex items-start gap-3">
              <div
                class="w-7 h-7 rounded-lg bg-accent/10 border border-accent/20 flex items-center justify-center text-accent mt-0.5 shrink-0"
              >
                <Database size={14} />
              </div>
              <p class="text-sm text-gray-300 leading-relaxed">
                <strong class="text-text-primary font-semibold">Biometric Sync:</strong>
                se integra con tus métricas de salud profunda para ajustar la intensidad.
              </p>
            </li>
          </ul>

          <a href="/quiz" class="inline-flex items-center gap-2 px-6 py-3 bg-accent text-bg-base rounded-lg font-semibold text-base hover:bg-accent-strong transition-colors">
            Iniciar diagnóstico IMR →
          </a>
        </div>

        <div class="relative">
          <div
            class="w-full aspect-[4/5] bg-bg-base rounded-xl border border-white/[0.08] overflow-hidden group"
          >
            <img
              src="/elena-mockup.webp"
              alt="ElenaApp metabolic dashboard"
              width="1024"
              height="1024"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-bg-base/60 via-transparent to-transparent z-10"
            >
            </div>
          </div>

          <!-- Floating UI Elements — system tokens, sin animate-bounce ni shadow-2xl -->
          <div
            class="absolute top-8 -right-4 lg:-right-8 z-20 bg-bg-surface border border-white/[0.1] rounded-lg p-3 hidden lg:block"
          >
            <div class="text-accent font-bold text-lg leading-none">+14%</div>
            <div class="text-[10px] text-text-muted uppercase tracking-wider mt-1">
              Sensibilidad insulínica
            </div>
          </div>

          <div class="absolute bottom-8 -left-4 lg:-left-8 z-20 bg-bg-surface border border-status-good/20 rounded-lg p-3 hidden lg:block">
            <div class="text-status-good font-bold text-lg leading-none">Óptimo</div>
            <div class="text-[10px] text-text-muted uppercase tracking-wider mt-1">
              Estado cetogénico
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SCIENCE IN ACTION SECTION -->
  <section id="ciencia" class="py-20 md:py-24 px-6">
    <div class="container mx-auto max-w-2xl">
      <div class="text-center mb-10">
        <p class="text-[11px] font-bold text-accent uppercase tracking-[0.2em] mb-3">Ciencia aplicada</p>
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-3 tracking-tight text-text-primary">
          Datos técnicos en salud real
        </h2>
        <p class="text-text-secondary text-base leading-relaxed max-w-xl mx-auto">
          No adivinamos: usamos la variabilidad de tu IMR para medir tu avance y lo ajustamos en tiempo real.
        </p>
      </div>

      <div class="space-y-5 text-text-secondary leading-relaxed">
        <p>
          El ayuno sugerido será el ideal para ti y puede ir cambiando a medida
          que vas mejorando tu metabolismo.
        </p>

        <p>
          Dominar tu metabolismo es entender cómo la estructura de los nutrientes
          y tus hábitos interactúan con tu ritmo circadiano. Es ciencia, no
          tendencia.
        </p>

        <TipsBox>
          Consume el 70% de tus carbohidratos tras entrenar. Esto activa el
          transporte de GLUT4 y nutre el músculo sin elevar la insulina basal.
        </TipsBox>
      </div>

      <div class="mt-12 pt-8 border-t border-white/[0.06] text-center">
        <h3 class="text-xl font-semibold text-text-primary tracking-tight mb-5">
          ¿Listo para calcular tu IMR?
        </h3>
        <a
          href="/quiz"
          class="inline-flex items-center gap-2 px-6 py-3 bg-accent text-bg-base rounded-lg font-semibold text-base hover:bg-accent-strong transition-colors"
        >
          Iniciar diagnóstico gratuito →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
