---
import { Database, LayoutDashboard, Smartphone } from "lucide-astro";
import Hero from "../components/Hero.astro";
import Pillars from "../components/Pillars.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import PostLinks from "../components/PostLinks.astro";
import { HOME_FEATURED, toLink } from "../data/relatedPosts";
const featured = HOME_FEATURED.map((s) => toLink(s)!).filter(Boolean);
import BaseLayout from "../layouts/BaseLayout.astro";
import AppStoreButton from "../components/AppStoreButton.astro";

// SPEC-079 + SPEC-108: title="" explícito → BaseLayout renderiza solo
// "Metamorfosis Real" como <title>, sin pipe huérfano.
const description =
  "Mejora tu salud metabólica con ayuno intermitente, sueño, ejercicio e hidratación, con fuentes científicas. Calculadora de grasa y app Elena gratis.";
---

<BaseLayout
  title="Salud metabólica y ayuno intermitente"
  description={description}
  preloadImage="/header-bg.webp"
  preloadImageType="image/webp"
>
  <!-- HERO SECTION -->
  <Hero />

  <!-- METABOLIC PILLARS -->
  <Pillars />

  <!-- ELENA APP PREVIEW / CONVERSION SECTION — SPEC-078: migrado a system -->
  <section id="protocolos" class="py-20 md:py-24 px-6">
    <div class="container mx-auto max-w-5xl">
      <div
        class="bg-bg-elevated border border-white/[0.08] rounded-2xl p-6 md:p-10 grid md:grid-cols-2 gap-8 md:gap-12 items-center"
      >
        <div>
          {/* SPEC-117: Elena ya está en App Store. Se retira el copy de
              "próximo nivel" y las funciones que la app no tiene
              ("Dynamic Protocol Logging", "dieta que cambia en tiempo real"). */}
          <div
            class="flex items-center gap-2 text-accent text-[11px] font-bold uppercase tracking-[0.2em] mb-4"
          >
            <Smartphone size={14} />
            Ya disponible: Elena para iPhone
          </div>
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-text-primary tracking-tight mb-5">
            Tu día metabólico en un solo puntaje
          </h2>
          <p class="text-gray-300 text-base md:text-lg mb-7 leading-relaxed">
            <span class="text-text-primary font-semibold">Elena</span> reúne ayuno,
            comida, sueño, ejercicio e hidratación en una sola pantalla y te dice
            qué hacer ahora. Gratis, en español.
          </p>

          <ul class="space-y-3 mb-8">
            <li class="flex items-start gap-3">
              <div
                class="w-7 h-7 rounded-lg bg-accent/10 border border-accent/20 flex items-center justify-center text-accent mt-0.5 shrink-0"
              >
                <LayoutDashboard size={14} />
              </div>
              <p class="text-sm text-gray-300 leading-relaxed">
                <strong class="text-text-primary font-semibold">Cada número con su fuente:</strong>
                los cálculos de la app enlazan los estudios y guías en los que se basan.
              </p>
            </li>
            <li class="flex items-start gap-3">
              <div
                class="w-7 h-7 rounded-lg bg-accent/10 border border-accent/20 flex items-center justify-center text-accent mt-0.5 shrink-0"
              >
                <Database size={14} />
              </div>
              <p class="text-sm text-gray-300 leading-relaxed">
                <strong class="text-text-primary font-semibold">Con Apple Salud, si quieres:</strong>
                lee tu peso, sueño y entrenamientos con tu permiso; si no, todo funciona con registro manual.
              </p>
            </li>
          </ul>

          <div class="flex flex-col sm:flex-row items-start gap-3">
            <AppStoreButton source="home_app_section" />
            <a href="/quiz" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-base text-text-primary border border-white/[0.12] hover:border-white/[0.2] transition-colors">
              Calcular mi IMR →
            </a>
          </div>
        </div>

        {/* SPEC-119: antes había una imagen generada (elena-mockup.webp) con
            una interfaz en inglés y funciones que la app no tiene (curva de
            glucosa de un sensor CGM). Se reemplaza por una descripción
            honesta de lo que registra la app. Cuando haya capturas reales
            de la versión publicada, van aquí. */}
        <div class="relative">
          <div class="w-full bg-bg-surface rounded-xl border border-white/[0.08] p-6 md:p-8">
            <p class="text-[11px] font-bold text-warm uppercase tracking-[0.2em] mb-5">Lo que registras cada día</p>
            <ul class="divide-y divide-white/[0.06]">
              <li class="py-4 flex gap-4"><span class="text-accent font-mono text-sm w-6 shrink-0">01</span><div><p class="text-text-primary font-semibold">Ayuno</p><p class="text-sm text-text-secondary">Inicio y fin de cada ayuno, con la ventana de alimentación.</p></div></li>
              <li class="py-4 flex gap-4"><span class="text-accent font-mono text-sm w-6 shrink-0">02</span><div><p class="text-text-primary font-semibold">Alimentación</p><p class="text-sm text-text-secondary">Qué comiste y a qué hora, sin contar calorías.</p></div></li>
              <li class="py-4 flex gap-4"><span class="text-accent font-mono text-sm w-6 shrink-0">03</span><div><p class="text-text-primary font-semibold">Ejercicio</p><p class="text-sm text-text-secondary">Fuerza y movimiento, manual o desde Apple Salud.</p></div></li>
              <li class="py-4 flex gap-4"><span class="text-accent font-mono text-sm w-6 shrink-0">04</span><div><p class="text-text-primary font-semibold">Sueño</p><p class="text-sm text-text-secondary">Horas y regularidad de tu descanso.</p></div></li>
              <li class="py-4 flex gap-4"><span class="text-accent font-mono text-sm w-6 shrink-0">05</span><div><p class="text-text-primary font-semibold">Hidratación</p><p class="text-sm text-text-secondary">El agua que tomas durante el día.</p></div></li>
            </ul>
            <p class="mt-5 text-xs text-text-muted leading-relaxed">Gratis para iPhone. Herramienta educativa: no diagnostica ni reemplaza a tu médico.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SPEC-120: enlaces a artículos desde la portada (antes no había ninguno). -->
  <section class="py-16 md:py-20 px-6">
    <div class="container mx-auto max-w-6xl">
      <PostLinks posts={featured} eyebrow="Para empezar" title="Un artículo por cada pilar" />
      <p class="mt-6 text-sm"><a href="/biblioteca" class="text-accent hover:underline">Ver todos los artículos →</a></p>
    </div>
  </section>

  <!-- SPEC-119: "Ciencia aplicada" reescrita. Antes afirmaba que el IMR se
       ajustaba "en tiempo real" (falso) y recomendaba "el 70 % de los
       carbohidratos tras entrenar … sin elevar la insulina basal" sin fuente.
       Ahora la sección dice cómo trabajamos y qué no hacemos. -->
  <section id="ciencia" class="py-20 md:py-24 px-6">
    <div class="container mx-auto max-w-4xl">
      <div class="text-center mb-10">
        <p class="text-[11px] font-bold text-accent uppercase tracking-[0.2em] mb-3">Cómo trabajamos</p>
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-3 tracking-tight text-text-primary">
          Información que puedes verificar
        </h2>
        <p class="text-text-secondary text-base leading-relaxed max-w-xl mx-auto">
          Hay demasiados consejos de salud sin respaldo. Estas son nuestras reglas.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-5">
        <div class="bg-bg-elevated border border-white/[0.08] rounded-xl p-6">
          <h3 class="text-base font-semibold text-text-primary mb-2">Cada dato con su fuente</h3>
          <p class="text-sm text-text-secondary leading-relaxed">Los artículos, la calculadora y la app citan los estudios y guías en los que se basan, con enlace para que los revises.</p>
        </div>
        <div class="bg-bg-elevated border border-white/[0.08] rounded-xl p-6">
          <h3 class="text-base font-semibold text-text-primary mb-2">Métodos públicos</h3>
          <p class="text-sm text-text-secondary leading-relaxed">Las fórmulas de la <a href="/calculadora-grasa-corporal" class="text-accent hover:underline">calculadora</a> y la <a href="/imr/metodologia" class="text-accent hover:underline">metodología del IMR</a> están publicadas. Cuando corregimos algo, lo decimos.</p>
        </div>
        <div class="bg-bg-elevated border border-white/[0.08] rounded-xl p-6">
          <h3 class="text-base font-semibold text-text-primary mb-2">No somos médicos</h3>
          <p class="text-sm text-text-secondary leading-relaxed">Es información educativa. Si tienes una condición de salud, tomas medicamentos o estás embarazada, habla con tu médico antes de ayunar o cambiar tu dieta.</p>
        </div>
      </div>

      <div class="mt-14 max-w-2xl mx-auto">
        <NewsletterSignup source="home" />
      </div>

      <div class="mt-12 pt-8 border-t border-white/[0.06] text-center">
        <h3 class="text-xl font-semibold text-text-primary tracking-tight mb-5">
          ¿Quieres saber cómo está tu salud metabólica?
        </h3>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/quiz"
            class="inline-flex items-center gap-2 px-6 py-3 bg-accent text-bg-base rounded-lg font-semibold text-base hover:bg-accent-strong transition-colors"
          >
            Hacer el test gratis →
          </a>
          <a
            href="/calculadora-grasa-corporal"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-base text-text-primary border border-white/[0.12] hover:border-white/[0.2] transition-colors"
          >
            Calcular mi grasa corporal
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
