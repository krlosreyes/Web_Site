---
import { Database, LayoutDashboard, Smartphone } from "lucide-astro";
import Hero from "../components/Hero.astro";
import Pillars from "../components/Pillars.astro";
import TipsBox from "../components/TipsBox.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Tu Metabolismo, Reiniciado | Metamorfosis Real";
const description =
  "Ecosistema de salud metabólica de alta autoridad. Optimiza tu biología con ciencia real y el motor de inteligencia de ElenaApp.";
---

<BaseLayout
  title={title}
  description={description}
  preloadImage="/header-bg.webp"
  preloadImageType="image/webp"
>
  <!-- HERO SECTION -->
  <Hero />

  <!-- METABOLIC PILLARS -->
  <Pillars />

  <!-- ELENA APP PREVIEW / CONVERSION SECTION -->
  <section id="protocolos" class="py-24 px-6 relative overflow-hidden">
    <div class="container mx-auto max-w-5xl">
      <div
        class="glass p-12 relative z-10 grid md:grid-cols-2 gap-12 items-center"
      >
        <div>
          <div
            class="flex items-center gap-2 text-accent-blue font-bold text-xs uppercase tracking-widest mb-4"
          >
            <Smartphone size={16} />
            El Próximo Nivel: ElenaApp
          </div>
          <h2 class="text-4xl font-heading font-bold text-text-primary mb-6">
            Tu Coach Metabólico <br /> en tu bolsillo
          </h2>
          <p class="text-text-secondary text-lg mb-8 leading-relaxed">
            Metamorfosis Real integra el motor de inteligencia de <span
              class="text-text-primary font-bold italic">ElenaApp</span
            > para ofrecerte protocolos hiper-personalizados basados en tu IMR (Índice
            de Metamorfosis Real).
          </p>

          <ul class="space-y-4 mb-10">
            <li class="flex items-start gap-3">
              <div
                class="w-6 h-6 rounded-full bg-accent-blue/20 flex items-center justify-center text-accent-blue mt-1 shrink-0"
              >
                <LayoutDashboard size={14} />
              </div>
              <p class="text-sm text-text-secondary">
                <strong class="text-text-primary"
                  >Dynamic Protocol Logging:</strong
                > Tu dieta cambia en tiempo real según tu bio-feedback diario.
              </p>
            </li>
            <li class="flex items-start gap-3">
              <div
                class="w-6 h-6 rounded-full bg-accent-blue/20 flex items-center justify-center text-accent-blue mt-1 shrink-0"
              >
                <Database size={14} />
              </div>
              <p class="text-sm text-text-secondary">
                <strong class="text-text-primary">Biometric Sync:</strong> Se integra
                con tus métricas de salud profunda para ajustar la intensidad.
              </p>
            </li>
          </ul>

          <a href="/quiz" class="btn-gradient inline-flex px-10 py-4 text-center">
            Iniciar Diagnóstico IMR
          </a>
        </div>

        <div class="relative">
          <div
            class="w-full aspect-[4/5] bg-bg-base/50 rounded-3xl border border-text-primary/5 shadow-2xl flex items-center justify-center overflow-hidden group"
          >
            <img
              src="/elena-mockup.webp"
              alt="ElenaApp Metabolic Dashboard Mockup"
              width="1024"
              height="1024"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-bg-base/80 via-transparent to-transparent z-10"
            >
            </div>
          </div>

          <!-- Floating UI Elements for premium feel -->
          <div
            class="absolute top-12 -right-12 z-20 glass p-4 shadow-2xl animate-bounce hover:animate-none hidden lg:block rotate-3"
          >
            <div class="text-accent-blue font-bold text-lg">+14%</div>
            <div class="text-[10px] text-text-secondary uppercase tracking-tighter">
              Sensibilidad Insulínica
            </div>
          </div>

          <div class="absolute bottom-12 -left-12 z-20 glass p-4 shadow-2xl hidden lg:block -rotate-3 border-health-green/20">
            <div class="text-health-green font-bold text-lg">OPTIMIZADO</div>
            <div class="text-[10px] text-text-secondary uppercase tracking-tighter">
              Estado Cetogénico
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SCIENCE IN ACTION SECTION -->
  <section id="ciencia" class="py-24 px-6 bg-bg-surface/10">
    <div class="container mx-auto max-w-2xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-heading font-bold mb-4">Ciencia Aplicada</h2>
        <p class="text-text-secondary">
          Convertimos datos técnicos en salud real. No adivinamos: usamos la
          variabilidad de tu IMR para medir tu avance y lo ajustamos en tiempo
          real.
        </p>
      </div>

      <div class="content-reading space-y-8">
        <p>
          El ayuno sugerido será el ideal para ti y puede ir cambiando a medida
          que vas mejorando tu metabolismo.
        </p>

        <p>
          Dominar tu metabolismo es entender cómo la estructura de los nutrientes
          y tus hábitos interactúan con tu ritmo circadiano. Es ciencia, no
          tendencia.
        </p>

        <TipsBox>
          Consume el 70% de tus carbohidratos tras entrenar. Esto activa el
          transporte de GLUT4 y nutre el músculo sin elevar la insulina basal.
        </TipsBox>
      </div>

      <div class="mt-16 pt-8 border-t border-text-primary/10 text-center">
        <h3 class="font-heading font-bold mb-6 text-xl">
          ¿Listo para calcular tu IMR?
        </h3>
        <a
          href="/quiz"
          class="btn-gradient px-12 py-5 text-xl inline-block shadow-accent-blue/20"
        >
          Iniciar Diagnóstico Gratuito IMR
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
