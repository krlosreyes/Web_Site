---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { db } from "../../lib/firebaseAdmin";
import { COLLECTIONS } from "../../lib/constants/firestore";
import { getPillar } from "../../lib/constants/pillars";
import { isValidSessionValue } from "../../lib/auth";
import ArticleQuiz from "../../components/ArticleQuiz";
import PostReactions from "../../components/blog/PostReactions";
import { Clock, Calendar, BookOpen, Link as LinkIcon } from "lucide-astro";
import { marked } from "marked";
import { enrichArticleHtml } from "../../lib/utils/enrichArticleHtml";

export const prerender = false;

const { slug } = Astro.params;
let article: any = null;

try {
    const postsRef = db.collection(COLLECTIONS.POSTS);
    const snapshot = await postsRef.where("slug", "==", slug).limit(1).get();

    if (!snapshot.empty) {
        article = { id: snapshot.docs[0].id, ...snapshot.docs[0].data() };
    }
} catch (error) {
    console.error("Error fetching article:", error);
}

if (!article) {
    return Astro.redirect("/404");
}

// SPEC-015: drafts solo se ven si quien pide es admin (preview pre-publicación).
// Visitantes anónimos reciben 404 igual que un slug inexistente.
const isDraft = article.status === "draft";
if (isDraft) {
    const sessionCookie = Astro.cookies.get("admin_session");
    const isAdminViewing = isValidSessionValue(sessionCookie?.value);
    if (!isAdminViewing) {
        return Astro.redirect("/404");
    }
}

// Limpiar prefijos dinámicamente
const cleanText = (text: string, prefix: string) => {
    return text.replace(new RegExp(`^${prefix}:?\\s*`, "i"), "").trim();
};

const cleanedContent = cleanText(article.content || "", "CONTENIDO");
const processedTitle = cleanText(article.title || "", "TÍTULO");
// SPEC-065: enriquece el HTML de marked con callouts diferenciados,
// IDs en H2, listas ✅/❌ y TOC auto-generado (≥3 H2). Si el contenido
// no usa los prefijos especiales, el output es el mismo que antes.
const rawHtml = marked.parse(cleanedContent) as string;
const { html: processedContent } = enrichArticleHtml(rawHtml);

const formatDate = (dateString?: string): string | null => {
    if (!dateString) return null;
    return new Date(dateString).toLocaleDateString("es-ES", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
};

// Tiempo de lectura estimado: ~200 palabras por minuto (lectura promedio).
// Usamos el contenido limpio (sin prefijos) para no contar la palabra "CONTENIDO".
const wordCount = cleanedContent.trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

// SPEC-025: la fecha pública del artículo refleja `publishedAt` (editable
// manualmente desde el admin via SPEC-023). Si el doc es legacy y solo tiene
// `createdAt`, cae a esa para no perder la fecha original.
const publishedAtIso = article.publishedAt || article.createdAt || null;
const updatedAtIso = article.updatedAt || null;
const formattedDate = formatDate(publishedAtIso);

// SPEC-027: SEO técnico — OG image del artículo + JSON-LD schema.org.
// SPEC-052: fallback default cambió de header-bg.jpg (2 MB) a og-image.jpg
// (41 KB, branded). Solo se usa cuando el artículo no tiene su propia
// imagen en `article.images`; si tiene, esa gana (artículo individual
// merece su preview específico).
const ogImage = (article.images && article.images[0]) || '/og-image.jpg';
const articleDescription = (article.content || '').substring(0, 160);

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: processedTitle,
    description: articleDescription,
    // SPEC-052b: URLs absolutas desde Astro.site (no Astro.url) para
    // que JSON-LD apunte al dominio real, no a localhost:4321/.
    image: ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site!).toString(),
    datePublished: publishedAtIso,
    dateModified: updatedAtIso || publishedAtIso,
    author: {
        '@type': 'Organization',
        name: 'Metamorfosis Real',
        url: 'https://metamorfosisvital.com.co',
    },
    publisher: {
        '@type': 'Organization',
        name: 'Metamorfosis Real',
        logo: {
            '@type': 'ImageObject',
            url: new URL('/logoSite.png', Astro.site!).toString(),
        },
    },
    mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': new URL(Astro.url.pathname, Astro.site!).toString(),
    },
};
---

<BaseLayout
    title={processedTitle}
    description={articleDescription}
    image={ogImage}
    ogType="article"
    publishedAt={publishedAtIso}
    updatedAt={updatedAtIso}
>
    {/* SPEC-027: schema.org Article para rich snippets en Google SERP */}
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(jsonLd)}
    ></script>
    <article class="min-h-screen relative bg-[#020617] overflow-hidden">
        <!-- Cuadrícula Técnica de Fondo (Sutil) -->
        <div
            class="absolute inset-0 z-0 pointer-events-none opacity-[0.03]"
            style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 40px 40px;"
        >
        </div>
        <div
            class="absolute inset-0 z-0 pointer-events-none bg-gradient-to-b from-transparent via-[#020617]/50 to-[#020617]"
        >
        </div>

        <!-- Hero Header Dinámico -->
        <div
            class={`relative ${article.images && article.images[0] ? "h-[60vh] min-h-[500px]" : "pt-40 pb-12"} w-full flex items-end overflow-hidden`}
        >
            {
                article.images && article.images[0] ? (
                    <div class="absolute inset-0">
                        <img
                            src={article.images[0]}
                            alt={processedTitle}
                            class="w-full h-full object-cover z-0 scale-105 hover:scale-100 transition-transform duration-1000"
                        />
                        <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px]" />
                    </div>
                ) : (
                    <div class="absolute inset-0 bg-gradient-to-br from-[#0c1422] to-[#020617] z-0" />
                )
            }
            <div
                class="absolute inset-0 bg-gradient-to-t from-[#020617] via-[#020617]/20 to-transparent z-10"
            >
            </div>

            <div class="container mx-auto px-6 relative z-20 max-w-4xl pb-16">
                {/* SPEC-072: badges en pill style del sistema (rounded-md +
                    bg-accent/10 + text-[11px] tracking proporcionado). Sin
                    gradient ni shadow azul. */}
                <div class="flex items-center gap-2 mb-6 flex-wrap">
                    <span
                        class="inline-flex items-center px-2.5 py-1 rounded-md bg-accent/10 border border-accent/20 text-accent text-[11px] font-bold uppercase tracking-[0.18em]"
                    >
                        Protocolo IMR
                    </span>
                    {/* SPEC-046: badge del pilar */}
                    {(() => {
                        const p = getPillar(article.pillar);
                        if (!p) return null;
                        return (
                            <span
                                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white/[0.04] border border-white/[0.1] text-text-secondary text-[11px] font-semibold uppercase tracking-[0.15em]"
                            >
                                <span class="text-sm leading-none">{p.emoji}</span>
                                {p.name}
                            </span>
                        );
                    })()}
                </div>
                {/* H1 expresivo (italic uppercase gradient) — regla del system:
                    UN h1 por vista puede ser expresivo. Este es el "hero"
                    del artículo. */}
                <h1
                    class="text-3xl sm:text-4xl md:text-5xl lg:text-7xl font-heading font-black leading-[1.05] mb-8 tracking-tighter drop-shadow-2xl italic uppercase bg-gradient-to-br from-white via-white to-[#00C49A] bg-clip-text text-transparent break-words"
                >
                    {processedTitle}
                </h1>
                {/* SPEC-072: metadata legible. Antes tracking-widest text-[10px]
                    (NASA telemetry). Ahora text-xs font-medium tracking-natural. */}
                <div
                    class="flex flex-wrap items-center gap-5 text-xs text-text-muted font-medium border-t border-white/[0.06] pt-6"
                >
                    {
                        formattedDate && (
                            <div class="flex items-center gap-2">
                                <Calendar size={14} class="text-accent" />
                                <span>{formattedDate}</span>
                            </div>
                        )
                    }
                    <div class="flex items-center gap-2">
                        <Clock size={14} class="text-accent" />
                        <span>{readingMinutes} min de lectura</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content Body -->
        <div class="container mx-auto px-6 pt-12 pb-0 flex justify-center">
            <div class="prose prose-invert max-w-[70ch] w-full">
                <div set:html={processedContent} />
            </div>
        </div>

        <!-- Footer Sections Container (Reactions, Quiz, References, CTA)
             SPEC-068: pt-12 md:pt-16 controla el espaciado entre el último
             elemento del prose y la primera card de footer. Antes el gap
             dependía del margin-bottom del último child del .prose (un <ol>
             con my-20 dejaba 80px; un <p> mucho menos), produciendo
             inconsistencia entre artículos. -->
        <div class="container mx-auto px-6 pt-12 md:pt-16 pb-24 max-w-3xl">
            {/* SPEC-032: reacciones del artículo (👍/👎)
                SPEC-035: hasQuiz cambia el CTA del anónimo a "Contesta el test"
                con scroll a #quiz-section, en lugar de mandar a /login. */}
            <PostReactions
                client:visible
                slug={slug}
                initialReactions={article.reactions || { likes: 0, dislikes: 0 }}
                hasQuiz={!!(article.quiz && article.quiz.length > 0)}
            />

            {/* SPEC-040 + SPEC-045: discutir el artículo en el foro.
                Padding equivalente a PostReactions (p-6 md:p-8) para peso
                visual coherente. Mobile-first: flex-col con CTA pill abajo;
                en sm+ pasa a row con el → compacto a la derecha. */}
            {/* SPEC-072: card con accent teal (no azul brillante), eyebrow
                proporcionado, copy tuteo neutro (sin voseo "Querés"). */}
            <a
                href={`/comunidad?createWithPost=${encodeURIComponent(slug ?? '')}&title=${encodeURIComponent(processedTitle)}${article.pillar ? `&pillar=${encodeURIComponent(article.pillar)}` : ''}`}
                class="mt-8 md:mt-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5 sm:gap-6 p-5 md:p-6 rounded-xl bg-bg-surface border border-accent/20 hover:border-accent/40 transition-colors group"
            >
                <div class="flex items-center gap-4 min-w-0">
                    <div class="w-10 h-10 rounded-lg bg-accent/10 border border-accent/20 flex items-center justify-center text-lg shrink-0">
                        💬
                    </div>
                    <div class="min-w-0">
                        <p class="text-[11px] font-bold text-accent uppercase tracking-[0.18em] mb-1">
                            La Tribu
                        </p>
                        <p class="text-sm md:text-base font-semibold text-text-primary break-words leading-snug">
                            ¿Quieres discutir este artículo con la comunidad?
                        </p>
                    </div>
                </div>
                <span class="self-start sm:self-auto inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-accent text-bg-base text-xs font-semibold group-hover:bg-accent-strong transition-colors shrink-0">
                    Abrir tema →
                </span>
            </a>

            {/* Interactive Quiz — SPEC-045: respiración de mt-12 md:mt-16 */}
            {
                article.quiz && article.quiz.length > 0 && (
                    <div id="quiz-section" class="mt-12 md:mt-16">
                        <ArticleQuiz
                            client:visible
                            questions={article.quiz}
                            articleId={slug}
                        />
                    </div>
                )
            }

            {/* Scientific References — SPEC-072: card del sistema, sin italic
                ni decoración 100px absoluta. Numeración accent teal. */}
            {
                article.references && article.references.length > 0 && (
                    <div class="mt-12 md:mt-16 p-6 md:p-8 bg-bg-surface border border-white/[0.06] rounded-xl">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-9 h-9 bg-accent/10 border border-accent/20 rounded-lg flex items-center justify-center">
                                <LinkIcon size={16} class="text-accent" />
                            </div>
                            <h3 class="text-base font-semibold text-text-primary tracking-tight">
                                Evidencia científica
                            </h3>
                        </div>
                        <ul class="space-y-3 m-0 p-0 list-none">
                            {article.references.map(
                                (ref: string, idx: number) => (
                                    <li class="flex items-start gap-3 text-sm text-text-secondary group m-0 leading-relaxed">
                                        <span class="text-accent font-mono font-semibold text-xs pt-0.5 shrink-0">
                                            {(idx + 1)
                                                .toString()
                                                .padStart(2, "0")}
                                        </span>
                                        <span class="group-hover:text-text-primary transition-colors">
                                            {ref}
                                        </span>
                                    </li>
                                ),
                            )}
                        </ul>
                    </div>
                )
            }

            {/* CTA Final — SPEC-072: card simple, sin radial gradient ni
                shadow-2xl ni halo blur en el botón. Texto proporcionado. */}
            <div
                class="mt-12 md:mt-16 p-6 md:p-10 bg-bg-surface border border-white/[0.06] rounded-xl text-center"
            >
                <div
                    class="inline-flex items-center gap-2 px-3 py-1.5 bg-accent/10 border border-accent/20 rounded-md text-[11px] font-bold text-accent uppercase tracking-[0.18em] mb-6"
                >
                    <BookOpen size={13} />
                    Siguiente paso
                </div>

                <h3
                    class="text-2xl md:text-3xl font-bold text-text-primary tracking-tight mb-3"
                >
                    Lleva esto a <span class="text-accent">la práctica</span>
                </h3>

                <p
                    class="text-text-secondary mb-7 max-w-md mx-auto text-base leading-relaxed"
                >
                    El conocimiento sin aplicación es solo información. Calcula tu IMR y empieza a medir lo que importa.
                </p>

                <a
                    href="/quiz"
                    class="inline-flex items-center gap-2 px-6 py-3 bg-accent text-bg-base rounded-lg font-semibold text-sm hover:bg-accent-strong transition-colors"
                >
                    Iniciar diagnóstico IMR
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    ><path d="M5 12h14m-7-7 7 7-7 7"></path></svg>
                </a>
            </div>

            {/* Sección de Comunidad / Foro — SPEC-072: rounded-xl (no [3rem]),
                sin blur-[100px] ni gradient cargado, paleta del sistema. */}
            <div
                id="community-cta"
                class="mt-12 md:mt-16 p-6 md:p-10 rounded-xl bg-bg-surface border border-white/[0.06]"
            >
                <div class="text-center max-w-xl mx-auto">
                    <span
                        class="text-[11px] font-bold text-accent uppercase tracking-[0.18em] mb-3 block"
                        >La Tribu</span
                    >
                    <h3
                        class="text-2xl md:text-3xl font-bold text-text-primary tracking-tight mb-4"
                    >
                        ¿Cómo te ha cambiado este tema?
                    </h3>
                    <p
                        class="text-text-secondary mb-7 text-base leading-relaxed"
                    >
                        Únete a la discusión con otros biohackers. Comparte tus dudas, victorias y biomarcadores en la comunidad privada.
                    </p>
                    <a
                        href="/comunidad"
                        class="inline-flex items-center gap-2 px-6 py-3 bg-accent text-bg-base rounded-lg font-semibold text-sm hover:bg-accent-strong transition-colors"
                    >
                        Entrar a la comunidad →
                    </a>
                </div>
            </div>

            <div class="flex justify-center mt-12">
                <a
                    href="/biblioteca"
                    class="text-sm font-medium text-text-muted hover:text-text-primary transition-colors"
                    >← Volver a la biblioteca</a
                >
            </div>
        </div>
    </article>

    <script>
        // Track reading progress: si el user scrollea más del 70% del artículo,
        // se marca como leído (gating para registrarse en /login → comunidad).
        const trackReading = () => {
            if (localStorage.getItem("imr_article_read") === "true") return;
            const onScroll = () => {
                const scrollPercent =
                    (window.scrollY + window.innerHeight) /
                    document.documentElement.scrollHeight;
                if (scrollPercent > 0.7) {
                    localStorage.setItem("imr_article_read", "true");
                    window.removeEventListener("scroll", onScroll);
                }
            };
            window.addEventListener("scroll", onScroll, { passive: true });
        };
        trackReading();
    </script>
</BaseLayout>

<style is:global>
    @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&display=swap");
    @reference "../../styles/global.css";

    .prose {
        color: #cbd5e1 !important;
        font-family: "Inter", sans-serif;
    }

    /* Tipografía de Párrafos */
    .prose p {
        @apply text-lg leading-[1.8] mb-10 text-gray-300 font-serif;
        font-family: "Playfair Display", serif;
    }

    /* Títulos con Protagonismo de Protocolo (Estilo Quiz) */
    .prose h2,
    .prose h3 {
        @apply flex items-center gap-5 font-black tracking-tighter uppercase italic text-white mt-24 mb-10 !not-italic;
        font-family: "Inter", sans-serif !important;
        font-style: italic !important;
        text-shadow: 0 0 20px rgba(255, 255, 255, 0.1);
    }

    /* Simulación de Icono de Quiz automático */
    .prose h2::before,
    .prose h3::before {
        content: "✦";
        @apply flex-shrink-0 flex items-center justify-center w-12 h-12 bg-blue-600/20 text-blue-400 rounded-xl border border-blue-500/30 text-2xl not-italic shadow-[0_0_15px_rgba(59,130,246,0.2)];
    }

    .prose h2 {
        @apply text-3xl md:text-4xl;
    }
    .prose h3 {
        @apply text-2xl md:text-3xl;
    }

    /* Bloques de Énfasis (Insight) */
    .prose blockquote {
        @apply bg-white/[0.03] backdrop-blur-xl border border-white/10 p-10 rounded-2xl text-center not-italic my-20 relative shadow-2xl;
        border-left: none !important;
    }
    .prose blockquote p {
        @apply !text-xl md:!text-2xl !font-black !text-white !leading-tight !m-0 !uppercase !italic !font-sans;
        background: linear-gradient(to right, #fff, #00c49a);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-family: "Inter", sans-serif !important;
    }
    .prose blockquote::before {
        content: "CLAVE DEL PROTOCOLO";
        @apply absolute -top-3 left-1/2 -translate-x-1/2 px-4 py-1 bg-[#00C49A] text-black text-[8px] font-black tracking-[0.4em] rounded-full shadow-lg;
    }

    /* Listas de Beneficios (Grid Automático) */
    .prose ul:has(li:nth-child(2)) {
        @apply grid grid-cols-1 md:grid-cols-2 gap-4 list-none p-0 my-16;
    }
    .prose ul li {
        @apply bg-white/[0.02] border border-white/5 p-6 rounded-xl m-0 flex items-center gap-4 transition-all duration-300 hover:bg-white/[0.05] hover:border-[#00C49A]/30;
    }
    .prose ul li::before {
        content: "✦";
        @apply text-[#00C49A] text-xl flex-shrink-0;
    }
    .prose ul li {
        @apply !font-bold !text-sm !text-gray-200 !leading-tight !font-sans;
    }

    /* Listas de Pasos (Roadmap) */
    .prose ol {
        @apply bg-white/[0.02] border border-white/5 p-8 md:p-12 rounded-2xl my-20 shadow-inner list-none relative overflow-hidden;
        counter-reset: steps-counter;
    }
    .prose ol li {
        @apply flex gap-6 items-center m-0 py-6 border-b border-white/5 last:border-0 relative font-sans font-bold text-gray-200;
        counter-increment: steps-counter;
    }
    .prose ol li::before {
        content: counter(steps-counter);
        @apply flex-shrink-0 w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-[#00C49A] text-white flex items-center justify-center font-black text-base shadow-lg shadow-blue-600/20;
    }

    /* Imágenes y Media */
    .prose img {
        @apply rounded-2xl shadow-2xl border border-white/10 my-12 w-full object-cover max-h-[500px];
    }

    /* Divisores de Gradiente */
    .prose hr {
        @apply h-px border-0 my-12 opacity-30;
        background: linear-gradient(
            to right,
            transparent,
            #00c49a,
            transparent
        ) !important;
    }

    /* Enlaces y Énfasis */
    .prose strong {
        @apply text-white font-black;
    }
    .prose a {
        @apply text-blue-400 no-underline border-b border-blue-400/30 hover:border-blue-400 transition-all;
    }

    /* ============================================================
       SPEC-065: Componentes editoriales avanzados (HubSpot-level)
       ============================================================ */

    /* --- Callouts diferenciados por tipo ---
       El helper enrichArticleHtml asigna estas clases al <blockquote>
       según el prefijo. Cada tipo tiene su color de border-left + acento.
       Si NO hay clase (blockquote crudo), se mantiene el estilo
       "CLAVE DEL PROTOCOLO" default definido más arriba. */

    .prose blockquote.callout-fast,
    .prose blockquote.callout-key,
    .prose blockquote.callout-perf,
    .prose blockquote.callout-transition,
    .prose blockquote.callout-impl {
        @apply bg-white/[0.04] backdrop-blur-md rounded-r-xl rounded-l-none p-6 md:p-8 my-12 not-italic shadow-lg text-left;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-left: 5px solid currentColor;
    }
    .prose blockquote.callout-fast::before,
    .prose blockquote.callout-key::before,
    .prose blockquote.callout-perf::before,
    .prose blockquote.callout-transition::before,
    .prose blockquote.callout-impl::before {
        content: none; /* override del badge "CLAVE DEL PROTOCOLO" */
    }
    .prose blockquote.callout-fast p,
    .prose blockquote.callout-key p,
    .prose blockquote.callout-perf p,
    .prose blockquote.callout-transition p,
    .prose blockquote.callout-impl p {
        @apply !text-base md:!text-lg !leading-relaxed !text-gray-200 !font-normal !m-0 !text-left !not-italic;
        font-family: "Inter", sans-serif !important;
        background: none !important;
        -webkit-text-fill-color: #e5e7eb !important;
        text-transform: none !important;
    }
    .prose blockquote.callout-fast p strong:first-child,
    .prose blockquote.callout-key p strong:first-child,
    .prose blockquote.callout-perf p strong:first-child,
    .prose blockquote.callout-transition p strong:first-child,
    .prose blockquote.callout-impl p strong:first-child {
        @apply block uppercase tracking-[0.2em] text-[10px] font-black mb-2;
    }

    /* Respuesta rápida — naranja (resumen TL;DR) */
    .prose blockquote.callout-fast { color: #F59E0B; }
    .prose blockquote.callout-fast p strong:first-child { color: #F59E0B !important; }
    /* Dato clave — azul (estadística importante) */
    .prose blockquote.callout-key { color: #3B82F6; }
    .prose blockquote.callout-key p strong:first-child { color: #3B82F6 !important; }
    /* Rendimiento comprobado — verde Metamorfosis (caso real / evidencia) */
    .prose blockquote.callout-perf { color: #00C49A; }
