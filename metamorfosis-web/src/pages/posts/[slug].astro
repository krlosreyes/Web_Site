---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { db } from "../../lib/firebaseAdmin";
import { COLLECTIONS } from "../../lib/constants/firestore";
import { isValidSessionValue } from "../../lib/auth";
import ArticleQuiz from "../../components/ArticleQuiz";
import PostReactions from "../../components/blog/PostReactions";
import { Clock, Calendar, BookOpen, Link as LinkIcon } from "lucide-astro";
import { marked } from "marked";

export const prerender = false;

const { slug } = Astro.params;
let article: any = null;

try {
    const postsRef = db.collection(COLLECTIONS.POSTS);
    const snapshot = await postsRef.where("slug", "==", slug).limit(1).get();

    if (!snapshot.empty) {
        article = { id: snapshot.docs[0].id, ...snapshot.docs[0].data() };
    }
} catch (error) {
    console.error("Error fetching article:", error);
}

if (!article) {
    return Astro.redirect("/404");
}

// SPEC-015: drafts solo se ven si quien pide es admin (preview pre-publicación).
// Visitantes anónimos reciben 404 igual que un slug inexistente.
const isDraft = article.status === "draft";
if (isDraft) {
    const sessionCookie = Astro.cookies.get("admin_session");
    const isAdminViewing = isValidSessionValue(sessionCookie?.value);
    if (!isAdminViewing) {
        return Astro.redirect("/404");
    }
}

// Limpiar prefijos dinámicamente
const cleanText = (text: string, prefix: string) => {
    return text.replace(new RegExp(`^${prefix}:?\\s*`, "i"), "").trim();
};

const cleanedContent = cleanText(article.content || "", "CONTENIDO");
const processedTitle = cleanText(article.title || "", "TÍTULO");
const processedContent = marked.parse(cleanedContent);

const formatDate = (dateString?: string): string | null => {
    if (!dateString) return null;
    return new Date(dateString).toLocaleDateString("es-ES", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
};

// Tiempo de lectura estimado: ~200 palabras por minuto (lectura promedio).
// Usamos el contenido limpio (sin prefijos) para no contar la palabra "CONTENIDO".
const wordCount = cleanedContent.trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

// SPEC-025: la fecha pública del artículo refleja `publishedAt` (editable
// manualmente desde el admin via SPEC-023). Si el doc es legacy y solo tiene
// `createdAt`, cae a esa para no perder la fecha original.
const publishedAtIso = article.publishedAt || article.createdAt || null;
const updatedAtIso = article.updatedAt || null;
const formattedDate = formatDate(publishedAtIso);

// SPEC-027: SEO técnico — OG image del artículo + JSON-LD schema.org
const ogImage = (article.images && article.images[0]) || '/header-bg.jpg';
const articleDescription = (article.content || '').substring(0, 160);

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: processedTitle,
    description: articleDescription,
    image: ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.url).toString(),
    datePublished: publishedAtIso,
    dateModified: updatedAtIso || publishedAtIso,
    author: {
        '@type': 'Organization',
        name: 'Metamorfosis Real',
        url: 'https://metamorfosisvital.com.co',
    },
    publisher: {
        '@type': 'Organization',
        name: 'Metamorfosis Real',
        logo: {
            '@type': 'ImageObject',
            url: new URL('/logoSite.png', Astro.url).toString(),
        },
    },
    mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': Astro.url.toString(),
    },
};
---

<BaseLayout
    title={processedTitle}
    description={articleDescription}
    image={ogImage}
    ogType="article"
    publishedAt={publishedAtIso}
    updatedAt={updatedAtIso}
>
    {/* SPEC-027: schema.org Article para rich snippets en Google SERP */}
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(jsonLd)}
    ></script>
    <article class="min-h-screen relative bg-[#020617] overflow-hidden">
        <!-- Cuadrícula Técnica de Fondo (Sutil) -->
        <div
            class="absolute inset-0 z-0 pointer-events-none opacity-[0.03]"
            style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 40px 40px;"
        >
        </div>
        <div
            class="absolute inset-0 z-0 pointer-events-none bg-gradient-to-b from-transparent via-[#020617]/50 to-[#020617]"
        >
        </div>

        <!-- Hero Header Dinámico -->
        <div
            class={`relative ${article.images && article.images[0] ? "h-[60vh] min-h-[500px]" : "pt-40 pb-12"} w-full flex items-end overflow-hidden`}
        >
            {
                article.images && article.images[0] ? (
                    <div class="absolute inset-0">
                        <img
                            src={article.images[0]}
                            alt={processedTitle}
                            class="w-full h-full object-cover z-0 scale-105 hover:scale-100 transition-transform duration-1000"
                        />
                        <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px]" />
                    </div>
                ) : (
                    <div class="absolute inset-0 bg-gradient-to-br from-[#0c1422] to-[#020617] z-0" />
                )
            }
            <div
                class="absolute inset-0 bg-gradient-to-t from-[#020617] via-[#020617]/20 to-transparent z-10"
            >
            </div>

            <div class="container mx-auto px-6 relative z-20 max-w-4xl pb-16">
                <div class="flex items-center gap-2 mb-6">
                    <span
                        class="px-3 py-1 bg-gradient-to-r from-blue-600 to-[#00C49A] text-white text-[9px] font-black uppercase tracking-[0.3em] rounded shadow-lg shadow-blue-500/20"
                    >
                        Protocolo de Autoridad IMR
                    </span>
                </div>
                <h1
                    class="text-3xl sm:text-4xl md:text-5xl lg:text-7xl font-heading font-black leading-[1.05] mb-8 tracking-tighter drop-shadow-2xl italic uppercase bg-gradient-to-br from-white via-white to-[#00C49A] bg-clip-text text-transparent break-words"
                >
                    {processedTitle}
                </h1>
                <div
                    class="flex flex-wrap items-center gap-8 text-[10px] text-gray-500 font-bold uppercase tracking-widest border-t border-white/5 pt-8"
                >
                    {
                        formattedDate && (
                            <div class="flex items-center gap-2">
                                <Calendar size={12} class="text-[#00C49A]" />
                                <span>{formattedDate}</span>
                            </div>
                        )
                    }
                    <div class="flex items-center gap-2">
                        <Clock size={12} class="text-[#00C49A]" />
                        <span>Estudio de {readingMinutes} min</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content Body -->
        <div class="container mx-auto px-6 pt-12 pb-0 flex justify-center">
            <div class="prose prose-invert max-w-[70ch] w-full">
                <div set:html={processedContent} />
            </div>
        </div>

        <!-- Footer Sections Container (Reactions, Quiz, References, CTA) -->
        <div class="container mx-auto px-6 pb-24 max-w-3xl">
            {/* SPEC-032: reacciones del artículo (👍/👎)
                SPEC-035: hasQuiz cambia el CTA del anónimo a "Contesta el test"
                con scroll a #quiz-section, en lugar de mandar a /login. */}
            <PostReactions
                client:visible
                slug={slug}
                initialReactions={article.reactions || { likes: 0, dislikes: 0 }}
                hasQuiz={!!(article.quiz && article.quiz.length > 0)}
            />

            {/* Interactive Quiz */}
            {
                article.quiz && article.quiz.length > 0 && (
                    <div id="quiz-section">
                        <ArticleQuiz
                            client:visible
                            questions={article.quiz}
                            articleId={slug}
                        />
                    </div>
                )
            }

            {/* Scientific References */}
            {
                article.references && article.references.length > 0 && (
                    <div class="mt-16 p-8 bg-white/[0.02] border border-white/5 rounded-2xl relative overflow-hidden">
                        <div class="absolute top-0 right-0 p-8 opacity-5">
                            <LinkIcon size={100} />
                        </div>
                        <div class="flex items-center gap-4 mb-8">
                            <div class="p-2.5 bg-blue-600/20 rounded-xl">
                                <LinkIcon size={20} class="text-blue-500" />
                            </div>
                            <h3 class="text-xl font-black text-white uppercase tracking-tighter italic">
                                Evidencia Científica
                            </h3>
                        </div>
                        <ul class="space-y-4 m-0 p-0 list-none">
                            {article.references.map(
                                (ref: string, idx: number) => (
                                    <li class="flex items-start gap-4 text-sm text-gray-400 group m-0">
                                        <span class="text-blue-500 font-mono font-bold text-xs pt-1">
                                            {(idx + 1)
                                                .toString()
                                                .padStart(2, "0")}
                                        </span>
                                        <span class="leading-relaxed group-hover:text-gray-200 transition-colors">
                                            {ref}
                                        </span>
                                    </li>
                                ),
                            )}
                        </ul>
                    </div>
                )
            }

            {/* CTA Final (Sleek Destination) */}
            <div
                class="mt-16 p-10 md:p-14 bg-[#050a1f] border border-white/10 rounded-2xl text-center relative overflow-hidden group shadow-2xl"
            >
                <!-- Efectos de Fondo -->
                <div
                    class="absolute inset-0 bg-[radial-gradient(circle_at_50%_-20%,rgba(0,196,154,0.1),transparent)]"
                >
                </div>

                <div class="relative z-10">
                    <div
                        class="inline-flex items-center gap-3 px-4 py-2 bg-[#00C49A]/10 border border-[#00C49A]/20 rounded-full text-[10px] font-black text-[#00C49A] uppercase tracking-[0.3em] mb-10"
                    >
                        <BookOpen size={14} />
                        Siguiente Nivel Alcanzado
                    </div>

                    <h3
                        class="text-3xl md:text-4xl font-black text-white mb-4 tracking-tighter uppercase italic leading-none"
                    >
                        Lleva esto a <span class="text-[#00C49A]"
                            >la práctica</span
                        >
                    </h3>

                    <p
                        class="text-gray-400 mb-10 max-w-sm mx-auto text-base leading-relaxed font-serif italic"
                    >
                        "El conocimiento sin aplicación es solo información. La
                        maestría biológica nace de la acción."
                    </p>

                    <a href="/quiz" class="group/btn relative inline-block">
                        <div
                            class="absolute -inset-1 bg-gradient-to-r from-[#00C49A] to-blue-600 rounded-xl blur opacity-20 group-hover/btn:opacity-100 transition duration-1000"
                        >
                        </div>
                        <div
                            class="relative px-10 py-4 bg-black border border-white/20 rounded-xl flex items-center gap-4 text-white font-black text-xs uppercase tracking-[0.3em] transition-all hover:border-white/40"
                        >
                            Iniciar Protocolo IMR
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="3"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path d="M5 12h14m-7-7 7 7-7 7"></path></svg
                            >
                        </div>
                    </a>
                </div>
            </div>
            {/* Sección de Comunidad / Foro Persuasiva */}
            <div
                id="community-cta"
                class="mt-24 p-12 rounded-[3rem] bg-gradient-to-br from-blue-900/40 to-[#00C49A]/10 border border-white/10 relative overflow-hidden group"
            >
                <div
                    class="absolute -top-24 -right-24 w-64 h-64 bg-blue-600/20 blur-[100px] rounded-full group-hover:bg-blue-600/30 transition-all"
                >
                </div>

                <div class="relative z-10 text-center">
                    <span
                        class="text-[10px] font-black text-blue-400 uppercase tracking-[0.3em] mb-4 block"
                        >El Nexo de Biohacking</span
                    >
                    <h3
                        class="text-3xl md:text-4xl font-black text-white italic uppercase tracking-tighter mb-6"
                    >
                        ¿Cómo te ha transformado este <span
                            class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-[#00C49A]"
                            >Protocolo</span
                        >?
                    </h3>
                    <p
                        class="text-gray-400 max-w-xl mx-auto mb-10 text-lg leading-relaxed"
                    >
                        Únete a la discusión con otros biohackers. Comparte tus
                        biomarcadores, dudas y victorias sobre este tema en
                        nuestra comunidad privada.
                    </p>
                    <a
                        href="/comunidad"
                        class="inline-block bg-white text-blue-600 px-10 py-4 rounded-2xl font-black text-sm uppercase tracking-widest hover:scale-[1.05] active:scale-95 transition-all shadow-2xl"
                    >
                        Participar en el Foro
                    </a>
                </div>
            </div>

            <div class="flex justify-center mt-16">
                <a
                    href="/biblioteca"
                    class="text-xs font-black text-gray-600 hover:text-white uppercase tracking-widest transition-all"
                    >← Volver a la Biblioteca</a
                >
            </div>
        </div>
    </article>

    <script>
        // Track reading progress: si el user scrollea más del 70% del artículo,
        // se marca como leído (gating para registrarse en /login → comunidad).
        const trackReading = () => {
            if (localStorage.getItem("imr_article_read") === "true") return;
            const onScroll = () => {
                const scrollPercent =
                    (window.scrollY + window.innerHeight) /
                    document.documentElement.scrollHeight;
                if (scrollPercent > 0.7) {
                    localStorage.setItem("imr_article_read", "true");
                    window.removeEventListener("scroll", onScroll);
                }
            };
            window.addEventListener("scroll", onScroll, { passive: true });
        };
        trackReading();
    </script>
</BaseLayout>

<style is:global>
    @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&display=swap");
    @reference "../../styles/global.css";

    .prose {
        color: #cbd5e1 !important;
        font-family: "Inter", sans-serif;
    }

    /* Tipografía de Párrafos */
    .prose p {
        @apply text-lg leading-[1.8] mb-10 text-gray-300 font-serif;
        font-family: "Playfair Display", serif;
    }

    /* Títulos con Protagonismo de Protocolo (Estilo Quiz) */
    .prose h2,
    .prose h3 {
        @apply flex items-center gap-5 font-black tracking-tighter uppercase italic text-white mt-24 mb-10 !not-italic;
        font-family: "Inter", sans-serif !important;
        font-style: italic !important;
        text-shadow: 0 0 20px rgba(255, 255, 255, 0.1);
    }

    /* Simulación de Icono de Quiz automático */
    .prose h2::before,
    .prose h3::before {
        content: "✦";
        @apply flex-shrink-0 flex items-center justify-center w-12 h-12 bg-blue-600/20 text-blue-400 rounded-xl border border-blue-500/30 text-2xl not-italic shadow-[0_0_15px_rgba(59,130,246,0.2)];
    }

    .prose h2 {
        @apply text-3xl md:text-4xl;
    }
    .prose h3 {
        @apply text-2xl md:text-3xl;
    }

    /* Bloques de Énfasis (Insight) */
    .prose blockquote {
        @apply bg-white/[0.03] backdrop-blur-xl border border-white/10 p-10 rounded-2xl text-center not-italic my-20 relative shadow-2xl;
        border-left: none !important;
    }
    .prose blockquote p {
        @apply !text-xl md:!text-2xl !font-black !text-white !leading-tight !m-0 !uppercase !italic !font-sans;
        background: linear-gradient(to right, #fff, #00c49a);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-family: "Inter", sans-serif !important;
    }
    .prose blockquote::before {
        content: "CLAVE DEL PROTOCOLO";
        @apply absolute -top-3 left-1/2 -translate-x-1/2 px-4 py-1 bg-[#00C49A] text-black text-[8px] font-black tracking-[0.4em] rounded-full shadow-lg;
    }

    /* Listas de Beneficios (Grid Automático) */
    .prose ul:has(li:nth-child(2)) {
        @apply grid grid-cols-1 md:grid-cols-2 gap-4 list-none p-0 my-16;
    }
    .prose ul li {
        @apply bg-white/[0.02] border border-white/5 p-6 rounded-xl m-0 flex items-center gap-4 transition-all duration-300 hover:bg-white/[0.05] hover:border-[#00C49A]/30;
    }
    .prose ul li::before {
        content: "✦";
        @apply text-[#00C49A] text-xl flex-shrink-0;
    }
    .prose ul li {
        @apply !font-bold !text-sm !text-gray-200 !leading-tight !font-sans;
    }

    /* Listas de Pasos (Roadmap) */
    .prose ol {
        @apply bg-white/[0.02] border border-white/5 p-8 md:p-12 rounded-2xl my-20 shadow-inner list-none relative overflow-hidden;
        counter-reset: steps-counter;
    }
    .prose ol li {
        @apply flex gap-6 items-center m-0 py-6 border-b border-white/5 last:border-0 relative font-sans font-bold text-gray-200;
        counter-increment: steps-counter;
    }
    .prose ol li::before {
        content: counter(steps-counter);
        @apply flex-shrink-0 w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-[#00C49A] text-white flex items-center justify-center font-black text-base shadow-lg shadow-blue-600/20;
    }

    /* Imágenes y Media */
    .prose img {
        @apply rounded-2xl shadow-2xl border border-white/10 my-12 w-full object-cover max-h-[500px];
    }

    /* Divisores de Gradiente */
    .prose hr {
        @apply h-px border-0 my-12 opacity-30;
        background: linear-gradient(
            to right,
            transparent,
            #00c49a,
            transparent
        ) !important;
    }

    /* Enlaces y Énfasis */
    .prose strong {
        @apply text-white font-black;
    }
    .prose a {
        @apply text-blue-400 no-underline border-b border-blue-400/30 hover:border-blue-400 transition-all;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
