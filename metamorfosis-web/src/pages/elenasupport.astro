---
/**
 * SPEC-112: Página pública de soporte de ElenaApp.
 *
 * Estructura lean por decisión de Carlos: intro corto + FAQ (5-6 items) +
 * formulario. Sin overview de features (para eso está la home).
 *
 * NO usa `noindex`: queremos que Google indexe esta página para que la gente
 * la encuentre al buscar "elena app soporte" o similares.
 */
import Layout from '../layouts/Layout.astro';
import ElenaSupportForm from '../components/ElenaSupportForm.tsx';
---

<Layout
    title="Soporte Elena App"
    description="Canal de soporte de Elena App. Reporta problemas técnicos, dudas de cuenta o compártenos feedback. Respondemos en 24-48 horas hábiles."
>
    <main class="min-h-screen bg-[#050810] pt-24 pb-20 overflow-hidden relative">
        {/* Ambient background — sutil, no compite con el contenido */}
        <div
            class="absolute top-0 right-0 w-[500px] h-[500px] bg-[#00C49A]/[0.06] blur-[150px] -z-10"
        >
        </div>
        <div
            class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-blue-600/[0.05] blur-[150px] -z-10"
        >
        </div>

        <div class="container mx-auto max-w-3xl px-6">
            {/* Header */}
            <div class="mb-10">
                <span
                    class="inline-block px-3 py-1 bg-[#00C49A]/[0.12] text-[#00C49A] text-[10px] font-black uppercase tracking-[0.2em] rounded-full border border-[#00C49A]/20 mb-4"
                >
                    Soporte Elena App
                </span>
                <h1
                    class="text-3xl sm:text-4xl md:text-5xl font-black text-white italic uppercase tracking-tight leading-tight mb-4 break-words"
                >
                    ¿Necesitas ayuda con <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-[#00C49A] to-emerald-400"
                        >Elena App</span
                    >?
                </h1>
                <p
                    class="text-gray-300 text-base sm:text-lg leading-relaxed max-w-2xl"
                >
                    Elena App es la app móvil de Metamorfosis Real para
                    optimizar tus hábitos día a día. Estamos en fase de
                    lanzamiento; si algo no anda como esperas o tienes una
                    duda concreta, escríbenos aquí. Solemos responder en
                    24–48 horas hábiles.
                </p>
            </div>

            {/* FAQ compacto */}
            <section class="mb-12" aria-labelledby="faq-heading">
                <h2
                    id="faq-heading"
                    class="text-xs font-black text-gray-400 uppercase tracking-[0.2em] mb-5"
                >
                    Preguntas frecuentes
                </h2>
                <div
                    class="rounded-2xl border border-white/10 bg-white/[0.02] divide-y divide-white/[0.06] overflow-hidden"
                >
                    <details class="group">
                        <summary
                            class="flex justify-between items-center gap-4 cursor-pointer px-5 py-4 hover:bg-white/[0.02] transition-colors list-none"
                        >
                            <span class="text-sm sm:text-base text-white font-medium"
                                >¿Cuándo puedo descargar Elena App?</span
                            >
                            <span
                                class="text-gray-500 group-open:rotate-45 transition-transform text-xl leading-none shrink-0"
                                aria-hidden="true">+</span
                            >
                        </summary>
                        <div class="px-5 pb-4 text-sm text-gray-400 leading-relaxed">
                            La app está en fase final de desarrollo. Si estás
                            en el <a
                                href="/quiz"
                                class="text-[#00C49A] hover:text-emerald-400 underline underline-offset-2"
                                >cohorte de acceso anticipado</a
                            >, te avisaremos por email en cuanto abramos
                            descargas.
                        </div>
                    </details>

                    <details class="group">
                        <summary
                            class="flex justify-between items-center gap-4 cursor-pointer px-5 py-4 hover:bg-white/[0.02] transition-colors list-none"
                        >
                            <span class="text-sm sm:text-base text-white font-medium"
                                >Me registré en el sitio, ¿ya estoy en Elena
                                App?</span
                            >
                            <span
                                class="text-gray-500 group-open:rotate-45 transition-transform text-xl leading-none shrink-0"
                                aria-hidden="true">+</span
                            >
                        </summary>
                        <div class="px-5 pb-4 text-sm text-gray-400 leading-relaxed">
                            Sí. Tu cuenta del sitio web y la de Elena App son
                            la misma (compartimos Firebase Auth). No necesitas
                            registrarte de nuevo cuando descargues la app.
                        </div>
                    </details>

                    <details class="group">
                        <summary
                            class="flex justify-between items-center gap-4 cursor-pointer px-5 py-4 hover:bg-white/[0.02] transition-colors list-none"
                        >
                            <span class="text-sm sm:text-base text-white font-medium"
                                >¿Cómo se conectan Elena App y el sitio
                                web?</span
                            >
                            <span
                                class="text-gray-500 group-open:rotate-45 transition-transform text-xl leading-none shrink-0"
                                aria-hidden="true">+</span
                            >
                        </summary>
                        <div class="px-5 pb-4 text-sm text-gray-400 leading-relaxed">
                            La app registra tus hábitos diarios (ayuno,
                            comidas, ejercicio, sueño) y los sincroniza con tu
                            perfil del sitio. Tu IMR, tu plan de 14 días y tu
                            historial viven en un mismo lugar.
                        </div>
                    </details>

                    <details class="group">
                        <summary
                            class="flex justify-between items-center gap-4 cursor-pointer px-5 py-4 hover:bg-white/[0.02] transition-colors list-none"
                        >
                            <span class="text-sm sm:text-base text-white font-medium"
                                >¿La app funciona sin internet?</span
                            >
                            <span
                                class="text-gray-500 group-open:rotate-45 transition-transform text-xl leading-none shrink-0"
                                aria-hidden="true">+</span
                            >
                        </summary>
                        <div class="px-5 pb-4 text-sm text-gray-400 leading-relaxed">
                            Puedes registrar tus hábitos sin conexión. La
                            sincronización con el sitio ocurre en cuanto
                            recuperas internet. No pierdes ningún dato.
                        </div>
                    </details>

                    <details class="group">
                        <summary
                            class="flex justify-between items-center gap-4 cursor-pointer px-5 py-4 hover:bg-white/[0.02] transition-colors list-none"
                        >
                            <span class="text-sm sm:text-base text-white font-medium"
                                >Reservé mi cupo, ¿pierdo mi lugar si no
                                descargo la app al momento?</span
                            >
                            <span
                                class="text-gray-500 group-open:rotate-45 transition-transform text-xl leading-none shrink-0"
                                aria-hidden="true">+</span
                            >
                        </summary>
                        <div class="px-5 pb-4 text-sm text-gray-400 leading-relaxed">
                            No. Tu lugar en el cohorte de acceso anticipado
                            queda vinculado a tu cuenta, no a que descargues
                            la app en un momento específico. Tienes tiempo.
                        </div>
                    </details>

                    <details class="group">
                        <summary
                            class="flex justify-between items-center gap-4 cursor-pointer px-5 py-4 hover:bg-white/[0.02] transition-colors list-none"
                        >
                            <span class="text-sm sm:text-base text-white font-medium"
                                >Tengo otro problema</span
                            >
                            <span
                                class="text-gray-500 group-open:rotate-45 transition-transform text-xl leading-none shrink-0"
                                aria-hidden="true">+</span
                            >
                        </summary>
                        <div class="px-5 pb-4 text-sm text-gray-400 leading-relaxed">
                            Descríbenos qué está pasando en el formulario de
                            abajo. Cuanto más detalle nos des (qué querías
                            hacer, qué esperabas, qué pasó), más rápido
                            podemos ayudarte.
                        </div>
                    </details>
                </div>
            </section>

            {/* Formulario */}
            <section aria-labelledby="form-heading">
                <h2
                    id="form-heading"
                    class="text-xs font-black text-gray-400 uppercase tracking-[0.2em] mb-5"
                >
                    Envíanos tu mensaje
                </h2>
                <ElenaSupportForm client:load />
            </section>
        </div>
    </main>
</Layout>
