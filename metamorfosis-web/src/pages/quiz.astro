---
import BaseLayout from "../layouts/BaseLayout.astro";
import IMRQuiz from "../components/IMRQuiz";
import MedicalDisclaimer from "../components/MedicalDisclaimer.astro";

// SPEC-118: título orientado a búsqueda ("test de salud metabólica").
const title = "Test de salud metabólica gratis";
const description = "Test gratuito de salud metabólica: conoce tu IMR en 2 minutos a partir de tus medidas y tus hábitos de ayuno, sueño, ejercicio e hidratación.";
---

<BaseLayout title={title} description={description}>
    <main class="min-h-[80vh] py-20 px-6">
        <div class="max-w-2xl mx-auto mb-6">
            <MedicalDisclaimer variant="full" />
        </div>
        <div class="flex items-center justify-center">
            <IMRQuiz client:load />
        </div>
    </main>
</BaseLayout>
