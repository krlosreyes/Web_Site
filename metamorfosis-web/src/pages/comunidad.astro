---
import Layout from '../layouts/Layout.astro';
import ForumEngine from '../components/community/ForumEngine';
import { Users } from 'lucide-astro';
---

<Layout title="Comunidad de salud metabólica y ayuno">
  <main class="min-h-screen bg-[#050810] pt-32 pb-20 overflow-hidden relative">
    {/* Fondos Ambientales */}
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-blue-600/10 blur-[150px] -z-10 animate-pulse"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-[#00C49A]/5 blur-[150px] -z-10"></div>

    <div class="container mx-auto max-w-7xl px-6">
      {/* Cabecera Estática Premium */}
      <div class="mb-12">
        {/* SPEC-119: se retiran los avatares de pravatar.cc (caras de personas
            que no son usuarios) y el "+1k": era prueba social inventada. */}
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white italic uppercase tracking-tighter leading-none mb-2 break-words">
          Metamorfosis <span class="text-gray-500">-</span> <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-[#00C49A]">La Tribu</span>
        </h1>
        <p class="text-gray-400 text-lg">Un espacio para compartir dudas y experiencias sobre ayuno, sueño, alimentación y ejercicio. Las respuestas de la comunidad no reemplazan una consulta médica.</p>
      </div>

      {/* EL MOTOR INTERACTIVO (REACT) */}
      <ForumEngine client:load />

    </div>
  </main>
</Layout>
