---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import UmamiScript from "../components/UmamiScript.astro";
import CookieBanner from "../components/CookieBanner.tsx";

interface Props {
    /** Título de la página. Si está vacío, se usa solo el nombre del sitio. */
    title?: string;
    description?: string;
    image?: string;
    canonicalURL?: string;
    /** SPEC-027: ogType='article' para artículos, default 'website'. */
    ogType?: 'website' | 'article';
    /** SPEC-027: ISO string. Solo se renderiza si ogType='article'. */
    publishedAt?: string | null;
    /** SPEC-027: ISO string. Solo se renderiza si ogType='article'. */
    updatedAt?: string | null;
    /**
     * SPEC-030: path absoluto al LCP image de la página para inyectar
     * <link rel="preload" as="image" fetchpriority="high">. Sin esto,
     * el browser no descubre el background-image hasta parsear el CSS.
     * Pasarlo SOLO en la página dueña del LCP (ej. home con el hero).
     */
    preloadImage?: string;
    /** SPEC-030: MIME type del preload image. Default 'image/webp'. */
    preloadImageType?: string;
}

const {
    title = "",
    description = "Metamorfosis Real - Ecosistema de salud metabólica de alta autoridad.",
    // SPEC-052: OG image branded dedicada 1200x630 (41 KB). Antes default
    // era header-bg.jpg (2 MB) — scrapers de LinkedIn/FB legacy tienen
    // timeout agresivo con imágenes pesadas. og-image.jpg es JPG porque
    // OG scrapers no parsean webp confiable (SPEC-030 mantiene .jpg para
    // este caso); el JPG branded tiene logo + claim + CTA + URL.
    image = "/og-image.jpg",
    canonicalURL,
    ogType = "website",
    publishedAt = null,
    updatedAt = null,
    preloadImage,
    preloadImageType = "image/webp",
} = Astro.props;

const siteName = "Metamorfosis Real";

// SPEC-052b: URLs absolutas construidas desde Astro.site (configurado en
// astro.config.mjs como https://metamorfosisvital.com.co). NO usar
// Astro.url para construir URLs absolutas porque cae a localhost:4321/
// cuando el request Host no se propaga bien a través del reverse proxy
// de Hostinger HCDN, rompiendo previews de OG en redes.
// Astro.url.pathname SÍ es confiable (es path relativo del request).
const SITE = Astro.site!;
const pageURL = new URL(Astro.url.pathname, SITE).href;
const imageURL = new URL(image, SITE).href;
const canonical = canonicalURL ?? pageURL;

// SPEC-079: lógica del title sin duplicar siteName.
// - Si title está vacío (home): mostrar solo siteName.
// - Si title ya contiene siteName (algunas páginas legacy): no duplicar.
// - Caso normal: "{title} | {siteName}".
const titleTrim = (title ?? "").trim();
const fullTitle = titleTrim === "" || titleTrim === siteName
    ? siteName
    : titleTrim.includes(siteName)
        ? titleTrim
        : `${titleTrim} | ${siteName}`;
// OG/Twitter usan el mismo title resuelto.
const ogTitle = fullTitle;
---

<!doctype html>
<html lang="es" class="dark">
    <head>
        <meta charset="utf-8" />
        {/* SPEC-079: favicon con el logo de Metamorfosis Real.
            - Primario: logoSite.webp (modernos navegadores soportan webp)
            - Fallback: logoSite.png (browsers viejos)
            - Apple touch icon: png alta resolución para iOS home screen */}
        <link rel="icon" type="image/webp" href="/logoSite.webp" />
        <link rel="icon" type="image/png" href="/logoSite.png" />
        <link rel="apple-touch-icon" href="/logoSite.png" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />

        <!-- Dynamic SEO — SPEC-079: title condicional (no duplica siteName) -->
        <title>{fullTitle}</title>
        <meta name="title" content={fullTitle} />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />

        <!-- Open Graph / Facebook (SPEC-027: site_name + locale + tipo dinámico).
             SPEC-052b: URLs absolutas desde Astro.site (no Astro.url) para
             que los scrapers de FB/Twitter/LinkedIn vean el dominio real
             (no localhost:4321 cuando el reverse proxy no propaga Host). -->
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:locale" content="es_CO" />
        <meta property="og:url" content={pageURL} />
        <meta property="og:title" content={ogTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={imageURL} />
        {ogType === 'article' && publishedAt && (
            <meta property="article:published_time" content={publishedAt} />
        )}
        {ogType === 'article' && updatedAt && (
            <meta property="article:modified_time" content={updatedAt} />
        )}
        {ogType === 'article' && (
            <meta property="article:author" content={siteName} />
        )}

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={pageURL} />
        <meta property="twitter:title" content={ogTitle} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={imageURL} />

        <!-- SPEC-030: preload del LCP image cuando la página lo declara.
             Mejora "Descubrimiento de solicitudes de LCP" de Lighthouse:
             sin esto, el background-image del Hero se descubre recién
             después de parsear el CSS, lo que retrasa el LCP. -->
        {preloadImage && (
            <link
                rel="preload"
                as="image"
                href={preloadImage}
                type={preloadImageType}
                fetchpriority="high"
            />
        )}

        <!-- SPEC-030b: preconnects a los terceros que Firebase Auth y Umami
             contactan al hidratarse. Lighthouse reportó ahorro estimado:
             firebaseapp.com (310ms) + umami.dev (300ms). El handshake
             DNS+TLS se hace en paralelo con el render, así cuando los
             componentes idle se hidratan y necesitan estos hosts, la
             conexión ya está caliente. -->
        <link rel="preconnect" href="https://elena-app-2026-v1.firebaseapp.com" crossorigin />
        <link rel="preconnect" href="https://api-gateway.umami.dev" crossorigin />

        <!-- SPEC-028: Analytics con Umami (excluye /admin/* y dev) -->
        <UmamiScript />

        <!-- Google Fonts: Space Grotesk & Inter
             SPEC-030: pattern non-blocking (preload as=style + media=print
             onload swap + noscript fallback). Intentamos self-hostear en
             SPEC-030c pero el script de descarga falló (WOFF2 del range
             wrong) y bajó Performance de 84 a 63. Revertido. Si en el
             futuro queremos volver a self-hostear, ver SPEC-030c para qué
             evitar (script Python debe filtrar @font-face por unicode-range
             latin antes de descargar). -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap"
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link
                href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap"
                rel="stylesheet"
            />
        </noscript>
    </head>
    <body class="bg-base text-primary">
        <!-- PERSISTENT GLOW -->
        <div class="bg-glow" aria-hidden="true"></div>

        <!-- USA EL COMPONENTE CENTRALIZADO NAVBAR -->
        <Navbar />

        <main class="relative z-10">
            <slot />
        </main>

        <!-- Footer único — SPEC-011/013: redes reales + navegación legal -->
        <Footer />

        <!-- SPEC-080: Banner de consentimiento cookies (Ley 1581 + GDPR friendly).
             client:idle para que aparezca después del LCP, no compita por main thread. -->
        <CookieBanner client:idle />
    </body>
</html>
