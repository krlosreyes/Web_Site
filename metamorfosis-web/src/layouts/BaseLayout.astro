---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import UmamiScript from "../components/UmamiScript.astro";

interface Props {
    title: string;
    description?: string;
    image?: string;
    canonicalURL?: string;
    /** SPEC-027: ogType='article' para artículos, default 'website'. */
    ogType?: 'website' | 'article';
    /** SPEC-027: ISO string. Solo se renderiza si ogType='article'. */
    publishedAt?: string | null;
    /** SPEC-027: ISO string. Solo se renderiza si ogType='article'. */
    updatedAt?: string | null;
    /**
     * SPEC-030: path absoluto al LCP image de la página para inyectar
     * <link rel="preload" as="image" fetchpriority="high">. Sin esto,
     * el browser no descubre el background-image hasta parsear el CSS.
     * Pasarlo SOLO en la página dueña del LCP (ej. home con el hero).
     */
    preloadImage?: string;
    /** SPEC-030: MIME type del preload image. Default 'image/webp'. */
    preloadImageType?: string;
}

const {
    title,
    description = "Metamorfosis Real - Ecosistema de salud metabólica de alta autoridad.",
    // SPEC-027: el default era /og-image.jpg (inexistente). Cambio a header-bg.jpg
    // que sí está en /public. Cuando se diseñe un OG asset dedicado, cambiar acá.
    // Nota SPEC-030: mantenemos el .jpg acá (no webp) porque algunos scrapers
    // de OG (LinkedIn, FB legacy) no parsean webp confiablemente.
    image = "/header-bg.jpg",
    canonicalURL = Astro.url.href,
    ogType = "website",
    publishedAt = null,
    updatedAt = null,
    preloadImage,
    preloadImageType = "image/webp",
} = Astro.props;

const siteName = "Metamorfosis Real";
---

<!doctype html>
<html lang="es" class="dark">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />

        <!-- Dynamic SEO -->
        <title>{title} | {siteName}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />

        <!-- Open Graph / Facebook (SPEC-027: site_name + locale + tipo dinámico) -->
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:locale" content="es_CO" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(image, Astro.url)} />
        {ogType === 'article' && publishedAt && (
            <meta property="article:published_time" content={publishedAt} />
        )}
        {ogType === 'article' && updatedAt && (
            <meta property="article:modified_time" content={updatedAt} />
        )}
        {ogType === 'article' && (
            <meta property="article:author" content={siteName} />
        )}

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={new URL(image, Astro.url)} />

        <!-- SPEC-030: preload del LCP image cuando la página lo declara.
             Mejora "Descubrimiento de solicitudes de LCP" de Lighthouse:
             sin esto, el background-image del Hero se descubre recién
             después de parsear el CSS, lo que retrasa el LCP. -->
        {preloadImage && (
            <link
                rel="preload"
                as="image"
                href={preloadImage}
                type={preloadImageType}
                fetchpriority="high"
            />
        )}

        <!-- SPEC-030b: preconnects a los terceros que Firebase Auth y Umami
             contactan al hidratarse. Lighthouse reportó ahorro estimado:
             firebaseapp.com (310ms) + umami.dev (300ms). El handshake
             DNS+TLS se hace en paralelo con el render, así cuando los
             componentes idle se hidratan y necesitan estos hosts, la
             conexión ya está caliente. -->
        <link rel="preconnect" href="https://elena-app-2026-v1.firebaseapp.com" crossorigin />
        <link rel="preconnect" href="https://api-gateway.umami.dev" crossorigin />

        <!-- SPEC-028: Analytics con Umami (excluye /admin/* y dev) -->
        <UmamiScript />

        <!-- SPEC-030c: Self-hosted fonts (Inter + Space Grotesk).
             Antes cargaban desde fonts.googleapis.com — 4 round trips (DNS,
             TLS, CSS, WOFF2) que sumaban ~610ms al critical path del LCP.
             Ahora WOFF2 viven en /public/fonts/ y se preloadean los dos
             críticos para el hero (Space Grotesk 700 para el heading,
             Inter 400 para el cuerpo). El resto se cargan lazy cuando los
             pida un selector. @font-face vive en global.css. -->
        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href="/fonts/space-grotesk-700.woff2"
            crossorigin
        />
        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href="/fonts/inter-400.woff2"
            crossorigin
        />
    </head>
    <body class="bg-base text-primary">
        <!-- PERSISTENT GLOW -->
        <div class="bg-glow" aria-hidden="true"></div>

        <!-- USA EL COMPONENTE CENTRALIZADO NAVBAR -->
        <Navbar />

        <main class="relative z-10">
            <slot />
        </main>

        <!-- Footer único — SPEC-011/013: redes reales + navegación legal -->
        <Footer />
    </body>
</html>
