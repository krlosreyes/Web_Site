---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title,
  description = "Metamorfosis Real - Ecosistema de salud metabólica de alta autoridad.",
  image = "/og-image.jpg",
  canonicalURL = Astro.url.href,
} = Astro.props;

const siteName = "Metamorfosis Real";
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- Dynamic SEO -->
    <title>{title} | {siteName}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- Google Fonts: Space Grotesk & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-base text-primary">
    <!-- PERSISTENT GLOW -->
    <div class="bg-glow" aria-hidden="true"></div>

    <!-- NAVBAR STICKY -->
    <header
      class="sticky top-0 z-50 w-full border-b border-text-primary/10 bg-bg-base/80 backdrop-blur-md"
    >
      <div
        class="container mx-auto px-6 h-20 flex items-center justify-between"
      >
        <a href="/" class="flex items-center gap-3 group">
          <img
            src="/logoSite.png"
            alt="Metamorfosis Real Logo"
            class="h-16 w-auto group-hover:scale-105 transition-transform drop-shadow-[0_0_20px_rgba(0,123,255,0.45)]"
          />
          <span
            class="font-heading font-bold text-3xl tracking-tight text-text-primary"
            >Metamorfosis<span class="text-accent-blue">Real</span></span
          >
        </a>

        <nav
          class="hidden md:flex items-center gap-8 font-heading text-sm font-medium text-text-secondary"
        >
          <a href="#" class="hover:text-text-primary transition-colors"
            >Ciencia</a
          >
          <a href="#" class="hover:text-text-primary transition-colors"
            >Protocolos</a
          >
          <a href="#" class="hover:text-text-primary transition-colors"
            >Comunidad</a
          >
        </nav>

        <div class="flex items-center gap-4">
          <a href="/quiz" class="btn-gradient px-5 py-2.5 text-sm">
            Calcular IMR
          </a>
          <a href="/admin" class="flex items-center gap-1 text-xs text-[#4a637e] hover:text-[#007BFF] transition-colors duration-200 font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 20 20" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 12a2 2 0 100-4 2 2 0 000 4zm7-2a7 7 0 11-14 0 7 7 0 0114 0zm-7-4v2m0 4v2" />
            </svg>
            Admin
          </a>
        </div>
      </div>
    </header>

    <main class="relative z-10">
      <slot />
    </main>

    <footer class="mt-20 border-t border-text-primary/10 py-12 bg-bg-surface">
      <div class="container mx-auto px-6 text-center">
        <p class="text-text-secondary text-sm">
          © 2026 Metamorfosis Real - Todos los derechos reservados.
        </p>
        <p class="mt-2 text-xs text-text-secondary/50">
          Impulsado por ElenaApp Metabolic Intelligence Engine.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Additional global overrides can go here */
  p {
    max-width: 65ch; /* Consistent reading width focus */
  }
</style>
