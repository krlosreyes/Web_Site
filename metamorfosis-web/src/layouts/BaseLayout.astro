---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import UmamiScript from "../components/UmamiScript.astro";

/**
 * BaseLayout — head + chrome (Navbar/Footer) compartido por todas las páginas.
 *
 * Historia:
 * - SPEC-027: SEO técnico inicial (canonical, OG, Twitter, sitemap, robots).
 * - SPEC-052b: URLs absolutas desde `Astro.site` (no `Astro.url`) porque el
 *   reverse proxy de Hostinger HCDN puede no propagar `Host` y `Astro.url`
 *   cae a `http://localhost:4321/`, rompiendo canonical, OG image, etc.
 * - SPEC-079: title vacío → solo "Metamorfosis Real" (sin pipe huérfano).
 * - SPEC-107: usar componentes Navbar/Footer reales (no hardcoded).
 * - SPEC-108: restaurar 052b + 079 + 027 que se perdieron en la reescritura
 *   de 107. Agregar prop `noindex`, JSON-LD Organization+WebSite, robots
 *   meta explícito, soporte de Google Search Console verification.
 */
interface Props {
    title?: string;
    description?: string;
    image?: string;
    canonicalURL?: string;
    /** SPEC-027: 'article' para artículos del blog, default 'website'. */
    ogType?: 'website' | 'article';
    /** SPEC-027: ISO string. Solo se renderiza si ogType='article'. */
    publishedAt?: string | null;
    /** SPEC-027: ISO string. Solo se renderiza si ogType='article'. */
    updatedAt?: string | null;
    /**
     * SPEC-030: path al LCP image para inyectar
     * <link rel="preload" as="image" fetchpriority="high">. Pasarlo SOLO
     * en la página dueña del LCP (ej. home con el hero background).
     */
    preloadImage?: string;
    /** SPEC-030: MIME del preload image. Default 'image/webp'. */
    preloadImageType?: string;
    /**
     * SPEC-108: marca la página como `noindex, nofollow`. Usar en
     * páginas privadas o gated (login, dashboards). Refuerza el
     * Disallow de robots.txt: si un bot ignora el disallow, igual
     * encuentra el meta noindex y descarta la URL del índice.
     */
    noindex?: boolean;
}

const {
    title,
    description = "Metamorfosis Real — Ecosistema de salud metabólica. Optimiza ayuno, nutrición, hidratación, sueño y ejercicio con ciencia real y el motor de inteligencia de ElenaApp.",
    // SPEC-052: OG image branded dedicada 1200×630 (84 KB).
    image = "/og-image.jpg",
    canonicalURL,
    ogType = "website",
    publishedAt = null,
    updatedAt = null,
    preloadImage,
    preloadImageType = "image/webp",
    noindex = false,
} = Astro.props;

const siteName = "Metamorfosis Real";

// SPEC-079 + SPEC-108: title fallback — sin title (o vacío), renderizar
// SOLO el siteName. Antes la home producía "<title> | Metamorfosis Real</title>"
// con pipe huérfano, lo cual Google muestra tal cual en SERP.
const pageTitle =
    title && title.trim().length > 0 ? `${title} | ${siteName}` : siteName;

// SPEC-052b: URLs absolutas desde Astro.site (commiteada en astro.config.mjs
// como https://metamorfosisvital.com.co). NO usar Astro.url para URLs
// absolutas — bajo el reverse proxy de Hostinger cae a localhost:4321/.
// `Astro.url.pathname` SÍ es confiable (no depende del host).
const SITE = Astro.site!;
const pageURL = new URL(Astro.url.pathname, SITE).href;
const imageURL = new URL(image, SITE).href;
const canonical = canonicalURL ?? pageURL;

// SPEC-108: robots meta explícito. `max-image-preview:large` habilita
// previews grandes en Google Discover y SERP. `max-snippet:-1` permite
// snippets de longitud completa.
const robotsContent = noindex
    ? "noindex, nofollow"
    : "index, follow, max-image-preview:large, max-snippet:-1";

// SPEC-108b: Google Search Console verification.
// Token de la propiedad de Carlos (krlosreyes2@gmail.com), método "meta tag"
// para https://www.metamorfosisvital.com.co/. El token es público por
// diseño (Google lo expone en el HTML servido), no es un secreto y por
// eso queda commiteado. Si en el futuro se rota la propiedad o se cambia
// el método, setear `PUBLIC_GSC_VERIFICATION` en Hostinger para
// sobreescribir el fallback sin tocar código.
const GSC_FALLBACK = "VWsHvjRtNCUgVX6rC0IYhGmiH0jRitHEu8rXd746S1A";
const gscVerification =
    process.env.PUBLIC_GSC_VERIFICATION ||
    import.meta.env.PUBLIC_GSC_VERIFICATION ||
    GSC_FALLBACK;

// SPEC-108: JSON-LD Organization + WebSite. Le dice a Google qué es
// el sitio, su logo y redes sociales, y habilita la sitelinks searchbox
// si en el futuro hay search interna. Solo se renderiza una vez por
// página, en el BaseLayout, para no duplicar con el JSON-LD de Article
// que ya inyecta posts/[slug].astro.
const organizationLd = {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: siteName,
    url: SITE.origin,
    logo: new URL("/logoSite.png", SITE).href,
    sameAs: [
        "https://www.youtube.com/@Metamorfosisreal",
        "https://www.facebook.com/metamorfosisrealoficial/",
        "https://www.tiktok.com/@metamorfosisreal",
    ],
};

const websiteLd = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteName,
    url: SITE.origin,
    inLanguage: "es",
    description,
};
---

<!doctype html>
<html lang="es" class="dark">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />

        <!-- SPEC-108: robots explícito (index/noindex según prop). -->
        <meta name="robots" content={robotsContent} />

        <!-- SPEC-108: Google Search Console verification, opcional vía env var. -->
        {gscVerification && (
            <meta name="google-site-verification" content={gscVerification} />
        )}

        <!-- SEO core -->
        <title>{pageTitle}</title>
        <meta name="title" content={pageTitle} />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />

        <!-- Open Graph / Facebook (SPEC-027 + SPEC-052b).
             URLs absolutas desde Astro.site para que los scrapers de
             FB/Twitter/LinkedIn vean el dominio real, no localhost. -->
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:locale" content="es_CO" />
        <meta property="og:url" content={pageURL} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={imageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        {ogType === 'article' && publishedAt && (
            <meta property="article:published_time" content={publishedAt} />
        )}
        {ogType === 'article' && updatedAt && (
            <meta property="article:modified_time" content={updatedAt} />
        )}
        {ogType === 'article' && (
            <meta property="article:author" content={siteName} />
        )}

        <!-- Twitter (usa name= según spec actual de Twitter Cards). -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={pageURL} />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageURL} />

        <!-- SPEC-108: JSON-LD Organization + WebSite en TODAS las páginas.
             Posts inyectan adicionalmente JSON-LD de Article. -->
        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify(organizationLd)}
        ></script>
        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify(websiteLd)}
        ></script>

        <!-- SPEC-030: preload del LCP image cuando la página lo declara.
             Sin esto el browser no descubre el background-image hasta
             parsear el CSS, retrasando el LCP. -->
        {preloadImage && (
            <link
                rel="preload"
                as="image"
                href={preloadImage}
                type={preloadImageType}
                fetchpriority="high"
            />
        )}

        <!-- SPEC-030b: preconnects a terceros que Firebase Auth y Umami
             contactan al hidratarse. DNS+TLS en paralelo con el render. -->
        <link rel="preconnect" href="https://elena-app-2026-v1.firebaseapp.com" crossorigin />
        <link rel="preconnect" href="https://api-gateway.umami.dev" crossorigin />

        <!-- SPEC-028: Umami analytics (excluye /admin/* y dev). -->
        <UmamiScript />

        <!-- Google Fonts: Space Grotesk & Inter — non-blocking pattern.
             SPEC-030: preload as=style + media=print + onload swap + noscript.
             SPEC-030c revertido: self-hosting bajó Performance 84→63. -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap"
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link
                href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap"
                rel="stylesheet"
            />
        </noscript>
    </head>
    <body class="bg-base text-primary">
        <!-- PERSISTENT GLOW -->
        <div class="bg-glow" aria-hidden="true"></div>

        {/* SPEC-107: Navbar real (gates auth, móvil, ElenaApp CTA). */}
        <Navbar />

        <main class="relative z-10">
            <slot />
        </main>

        {/* SPEC-107: Footer real (redes, recursos, aviso médico). */}
        <Footer />
    </body>
</html>

<style is:global>
    /* Reading-width focus para párrafos en prose. */
    p {
        max-width: 65ch;
    }
</style>
