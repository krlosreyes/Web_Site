---
/**
 * Layout.astro — alias de BaseLayout.astro tras SPEC-013.
 *
 * Antes este layout aplicaba un tema CLARO (fondo gris con texto oscuro)
 * mientras BaseLayout aplicaba el tema OSCURO. El sitio cambiaba bruscamente
 * de estética al navegar de una página a otra. SPEC-013 unifica todo al tema
 * oscuro que es el que define la identidad de marca.
 *
 * Las páginas que importaban `Layout.astro` (terminos, privacidad, sobre-mi,
 * protocolo, dashboard-7d, comunidad, diagnostico, calculadora, login,
 * admin/*) siguen funcionando sin cambios — internamente delegan a
 * BaseLayout. Cuando consideremos migrar todas las páginas a importar
 * BaseLayout directamente, eliminamos este archivo (otra spec).
 */
import BaseLayout from "./BaseLayout.astro";

interface Props {
    title: string;
    description?: string;
    /** SPEC-108: páginas privadas (login, gated) pueden marcarse noindex. */
    noindex?: boolean;
}

const props = Astro.props;
---

<BaseLayout {...props}>
    <slot />
</BaseLayout>
