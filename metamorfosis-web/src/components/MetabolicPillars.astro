---
const icons = {
    timer: `<svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='#007BFF' class='w-8 h-8'><circle cx='12' cy='13' r='8' stroke-width='2'/><path stroke-width='2' d='M12 9v4l2 2'/></svg>`,
    shield: `<svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='#007BFF' class='w-8 h-8'><path stroke-width='2' d='M12 3l8 4v5c0 5.25-3.5 9.75-8 11-4.5-1.25-8-5.75-8-11V7l8-4z'/></svg>`,
    dumbbell: `<svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='#007BFF' class='w-8 h-8'><rect x='2' y='9' width='20' height='6' rx='2' stroke-width='2'/></svg>`,
    droplet: `<svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='#007BFF' class='w-8 h-8'><path stroke-width='2' d='M12 2.5C12 2.5 6 10 6 14a6 6 0 0012 0c0-4-6-11.5-6-11.5z'/></svg>`,
    moon: `<svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='#007BFF' class='w-8 h-8'><path stroke-width='2' d='M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z'/></svg>`,
} as const;

type IconKey = keyof typeof icons;
type Pillar = {
    icon: IconKey;
    title: string;
    desc: string;
};

const pillars: Pillar[] = [
    {
        icon: "timer",
        title: "Ayuno Intermitente Inteligente",
        desc: "Gestión de ventanas metabólicas para activar la autofagia y flexibilidad energética.",
    },
    {
        icon: "shield",
        title: "Nutrición Real y Antiinflamatoria",
        desc: "Enfoque en densidad nutricional y control de insulina sin dietas restrictivas.",
    },
    {
        icon: "dumbbell",
        title: "Ejercicio de Fuerza y Movimiento Vital",
        desc: "Músculo como seguro de vida metabólico y optimización del metabolismo basal.",
    },
    {
        icon: "droplet",
        title: "Hidratación Estratégica y Electrolitos",
        desc: "Equilibrio mineral para la función celular y energía, más allá del agua simple.",
    },
    {
        icon: "moon",
        title: "Sueño Reparador y Ritmos Circadianos",
        desc: "Regulación hormonal (cortisol/GH) y reparación celular profunda.",
    },
];
---

<div
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 max-w-7xl mx-auto py-8"
>
    {
        pillars.map((pillar) => (
            <div
                class="bg-[#0c1422] rounded-xl p-6 flex flex-col items-center text-center shadow-lg border border-transparent hover:border-[#007BFF] transition-all group cursor-pointer"
                style="min-height: 260px;"
            >
                <div class="mb-4" set:html={icons[pillar.icon]} />
                <h3
                    class="font-heading font-bold text-xl mb-2 text-white tracking-tight"
                    style="font-family: 'Space Grotesk', sans-serif"
                >
                    {pillar.title}
                </h3>
                <p
                    class="text-base text-white/80"
                    style="font-family: 'Inter', sans-serif"
                >
                    {pillar.desc}
                </p>
            </div>
        ))
    }
</div>

---

