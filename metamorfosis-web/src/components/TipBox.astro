---
// Props: title (string)
const { title } = Astro.props;
---

<section
    class="bg-[#0c1422] border-l-4 border-[#22c55e] rounded-md p-4 my-6 max-w-2xl mx-auto"
>
    {title && <h3 class="text-[#22c55e] font-bold mb-2 text-lg">{title}</h3>}
    <div class="prose prose-invert text-base text-white space-y-2">
        <slot />
    </div>
</section>
