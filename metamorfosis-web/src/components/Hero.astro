---
import { ArrowRight } from 'lucide-astro';
---
<section class="hero-section relative min-h-[92vh] flex items-center px-6 overflow-hidden">

  {/* Background image layer */}
  <div class="hero-bg-image" aria-hidden="true"></div>

  {/* Gradient overlay - left dark, right reveals image */}
  <div class="absolute inset-0 z-[1]" style="background: linear-gradient(to right, rgba(5,10,18,0.97) 0%, rgba(5,10,18,0.85) 45%, rgba(5,10,18,0.35) 75%, rgba(5,10,18,0.1) 100%);"></div>

  {/* Bottom fade to body */}
  <div class="absolute bottom-0 left-0 right-0 h-40 z-[2]" style="background: linear-gradient(to bottom, transparent, #050a12);"></div>

  {/* Content */}
  <div class="container mx-auto max-w-6xl relative z-10">
    {/* SPEC-053: container responsive. En mobile max-w-2xl es OK porque el
        H1 wrappea natural. En tablet/desktop necesitamos más ancho para que
        cada frase del H1 quepa en una sola línea (con whitespace-nowrap). */}
    <div class="max-w-2xl md:max-w-3xl lg:max-w-4xl text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-blue/10 border border-accent-blue/20 text-accent-blue text-xs font-bold uppercase tracking-widest mb-6">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-blue opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-accent-blue"></span>
        </span>
        Ecosistema Metamorfosis Real
      </div>

      {/* SPEC-053: copy refresh + responsive del H1.
          Copy: el user es el protagonista — "te damos las herramientas, tú creas
          los hábitos". Subtítulo emocional.
          Responsive: en mobile cada frase wrappea naturalmente en 2-3 líneas
          (text-4xl, sin nowrap). Desde md (tablet portrait, 768px+) cada frase
          se fuerza a UNA línea con `md:whitespace-nowrap` y font escalado para
          que quepa: text-5xl en md, text-6xl en lg. text-7xl quedó fuera
          intencionalmente — 25 chars en text-7xl no caben en max-w-4xl. */}
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-bold text-text-primary mb-8 leading-[1.05] tracking-tight break-words">
        <span class="md:whitespace-nowrap">Te damos las herramientas</span><br/><span class="md:whitespace-nowrap bg-clip-text text-transparent bg-gradient-to-r from-accent-blue to-cyan-400">Tú creas los hábitos.</span>
      </h1>

      {/* SPEC-053: subtítulo emocional con tratamiento glass para
          darle protagonismo sin agrandar el tamaño ni opacar los CTAs.
          - bg semi-transparente + backdrop-blur: efecto vidrio sobre el hero
          - border-left grueso en accent-blue: ancla visual asimétrica
          - rounded-r-2xl: esquinas redondeadas solo a la derecha (más design-y)
          - shadow azul tenue (opacity 0.15): glow sin gritar
          - italic + text-primary (no secondary): el texto pesa más
          - inline-block: solo abraza el texto, no ocupa toda la fila */}
      <div class="inline-block bg-bg-surface/20 backdrop-blur-md border-l-4 border-accent-blue rounded-r-2xl px-6 py-4 mb-10 shadow-[0_0_30px_rgba(0,123,255,0.15)] max-w-xl">
        <p class="text-xl text-text-primary leading-relaxed italic font-medium">
          Vida solo hay una y todo cuenta.
        </p>
      </div>
      
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <a href="/quiz" class="btn-gradient px-8 py-4 text-lg flex items-center gap-2">
          Obtener mi Diagnóstico IMR <ArrowRight size={20} />
        </a>
        <a href="#pilares" class="px-8 py-4 rounded-xl border border-text-primary/20 bg-white/5 backdrop-blur-sm text-text-primary font-bold hover:bg-white/10 transition-all">
          Explorar el Ecosistema
        </a>
      </div>

      {/* Subtle stats row */}
      <div class="mt-14 flex items-center gap-8">
        <div>
          <p class="text-2xl font-bold font-heading text-text-primary">10K+</p>
          <p class="text-xs text-text-secondary uppercase tracking-widest">Usuarios Activos</p>
        </div>
        <div class="w-px h-10 bg-text-primary/10"></div>
        <div>
          <p class="text-2xl font-bold font-heading text-health-green">94%</p>
          <p class="text-xs text-text-secondary uppercase tracking-widest">Mejora Metabólica</p>
        </div>
        <div class="w-px h-10 bg-text-primary/10"></div>
        <div>
          <p class="text-2xl font-bold font-heading text-accent-blue">IMR</p>
          <p class="text-xs text-text-secondary uppercase tracking-widest">Índice Propio</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    background-color: #050a12;
  }

  .hero-bg-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    /* SPEC-030: webp (-93% peso vs el jpg/png original de 2MB). */
    background-image: url('/header-bg.webp');
    background-size: cover;
    background-position: center right;
    background-repeat: no-repeat;
    /* Subtle Ken Burns animation */
    animation: heroZoom 20s ease-in-out infinite alternate;
  }

  @keyframes heroZoom {
    from { transform: scale(1.0); }
    to   { transform: scale(1.06); }
  }
</style>
