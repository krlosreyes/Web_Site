---
import { ArrowRight, Youtube } from 'lucide-astro';

/**
 * SPEC-098: stats row reescrito. Eliminadas las métricas inventadas
 * ("10K+ Usuarios activos", "94% Mejora metabólica") por riesgo de
 * credibilidad y posible exposición regulatoria (claim de eficacia
 * sin metodología publicada).
 *
 * Tile 1: suscriptores reales del canal YouTube. Hardcoded acá —
 * actualizar manualmente cuando el canal crezca. Un commit + push
 * → 90-120s de deploy. Decisión Carlos 2026-05-19 (en vez de env
 * var en Hostinger) por simplicidad operativa.
 *
 * Tile 2: statement honesto del estado del proyecto, sin número.
 *
 * Tile 3: IMR / Índice propio — sin cambio.
 */
// ⬇ ACTUALIZAR AQUÍ cuando el canal de YouTube crezca.
const YOUTUBE_SUBSCRIBERS = '4.5K';
const YOUTUBE_CHANNEL_URL = 'https://www.youtube.com/@Metamorfosisreal';
---
<section class="hero-section relative min-h-[92vh] flex items-center px-6 overflow-hidden">

  {/* Background image layer */}
  <div class="hero-bg-image" aria-hidden="true"></div>

  {/* Gradient overlay - left dark, right reveals image */}
  <div class="absolute inset-0 z-[1]" style="background: linear-gradient(to right, rgba(2,6,23,0.97) 0%, rgba(2,6,23,0.85) 45%, rgba(2,6,23,0.35) 75%, rgba(2,6,23,0.1) 100%);"></div>

  {/* Bottom fade to body */}
  <div class="absolute bottom-0 left-0 right-0 h-40 z-[2]" style="background: linear-gradient(to bottom, transparent, #020617);"></div>

  {/* Content */}
  <div class="container mx-auto max-w-6xl relative z-10">
    {/* SPEC-053: container responsive. En mobile max-w-2xl es OK porque el
        H1 wrappea natural. En tablet/desktop necesitamos más ancho para que
        cada frase del H1 quepa en una sola línea (con whitespace-nowrap). */}
    <div class="max-w-2xl md:max-w-3xl lg:max-w-4xl text-left">
      {/* SPEC-072: pill en accent teal (paleta del sistema), no azul brillante.
          rounded-md (no rounded-full) para coherencia con .pill del system. */}
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-accent/10 border border-accent/20 text-accent text-[11px] font-bold uppercase tracking-[0.2em] mb-6">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
        </span>
        Ecosistema Metamorfosis Real
      </div>

      {/* SPEC-072: h1 con gradient teal (no azul-cyan) en la palabra clave.
          Mantenemos el copy y la responsividad de SPEC-053. */}
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-bold text-text-primary mb-8 leading-[1.05] tracking-tight break-words">
        <span class="md:whitespace-nowrap">Te damos las herramientas</span><br/><span class="md:whitespace-nowrap bg-clip-text text-transparent bg-gradient-to-r from-[#00C49A] to-emerald-400">Tú creas los hábitos.</span>
      </h1>

      {/* SPEC-072: subtítulo simplificado. Antes tenía glass treatment
          cargado (backdrop-blur + shadow azul + rounded-r-2xl). Ahora solo
          border-left sutil del accent + italic. Más sobrio, igual de
          legible, alineado con el design system premium. */}
      <p class="border-l-2 border-accent pl-5 mb-10 text-xl text-text-primary/90 italic font-medium leading-relaxed max-w-xl">
        Vida solo hay una y todo cuenta.
      </p>

      <div class="flex flex-col sm:flex-row items-start gap-3">
        {/* CTA primario — accent teal sólido.
            SPEC-084: tracking declarativo de Umami. data-umami-event define el
            nombre del evento; data-umami-event-* añade properties. */}
        <a
          href="/quiz"
          data-umami-event="cta_quiz_iniciar"
          data-umami-event-source="hero"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-accent text-bg-base font-semibold text-base hover:bg-accent-strong transition-colors"
        >
          Obtener mi diagnóstico IMR <ArrowRight size={18} />
        </a>
        {/* CTA secundario — outline limpio. */}
        <a
          href="#pilares"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-bg-surface/60 text-text-primary font-semibold text-base border border-white/[0.12] hover:bg-bg-surface hover:border-white/[0.2] transition-colors"
        >
          Explorar el ecosistema
        </a>
      </div>

      {/* SPEC-098: stats row honesto. Métricas inventadas reemplazadas
          por suscriptores YouTube real (hardcoded) + estado real del
          proyecto + tile IMR. */}
      <div class="mt-14 flex items-center gap-6 md:gap-8">
        <a
          href={YOUTUBE_CHANNEL_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-umami-event="cta_youtube_hero"
          class="group block hover:-translate-y-0.5 transition-transform"
          aria-label="Visitar el canal de YouTube Metamorfosis Real"
        >
          {/* Logo YouTube en rojo brand (#FF0000) para reconocimiento
              instantáneo. Único color off-paleta del Hero — estándar de la
              industria para iconos de plataformas en stat rows. */}
          <p class="text-2xl font-bold text-text-primary group-hover:text-accent transition-colors flex items-center gap-2">
            <Youtube class="w-6 h-6 text-[#FF0000] fill-[#FF0000]" aria-hidden="true" />
            <span>{YOUTUBE_SUBSCRIBERS}</span>
          </p>
          <p class="text-[11px] text-text-muted group-hover:text-text-secondary uppercase tracking-[0.2em] mt-0.5 inline-flex items-center gap-1 transition-colors">
            Suscriptores en YouTube
            <span class="text-accent opacity-0 group-hover:opacity-100 transition-opacity">↗</span>
          </p>
        </a>
        <div class="w-px h-10 bg-white/[0.08]"></div>
        <div>
          <p class="text-2xl font-bold text-accent">BETA</p>
          <p class="text-[11px] text-text-muted uppercase tracking-[0.2em] mt-0.5">Cohorte 2026 activa</p>
        </div>
        <div class="w-px h-10 bg-white/[0.08]"></div>
        <a
          href="/imr"
          data-umami-event="cta_imr_explicacion"
          class="group block hover:-translate-y-0.5 transition-transform"
          aria-label="Conocer el IMR: índice propio de Metamorfosis Real"
        >
          <p class="text-2xl font-bold text-text-primary group-hover:text-accent transition-colors">IMR</p>
          <p class="text-[11px] text-text-muted group-hover:text-text-secondary uppercase tracking-[0.2em] mt-0.5 inline-flex items-center gap-1 transition-colors">
            Índice propio
            <span class="text-accent opacity-0 group-hover:opacity-100 transition-opacity">→</span>
          </p>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    background-color: #020617;
  }

  .hero-bg-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    /* SPEC-030: webp (-93% peso vs el jpg/png original de 2MB). */
    background-image: url('/header-bg.webp');
    background-size: cover;
    background-position: center right;
    background-repeat: no-repeat;
    /* Subtle Ken Burns animation */
    animation: heroZoom 20s ease-in-out infinite alternate;
  }

  @keyframes heroZoom {
    from { transform: scale(1.0); }
    to   { transform: scale(1.06); }
  }
</style>
