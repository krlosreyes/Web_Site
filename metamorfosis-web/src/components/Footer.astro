---
import { Facebook, Instagram, Youtube } from "lucide-astro";
import { isValidSessionValue } from "../lib/auth";

// Detección de sesión admin para mostrar/ocultar UI condicional.
// El check de production de ADMIN_PASSWORD vive solo en endpoints/páginas que
// realmente lo necesitan; el footer no debe romper el render del sitio entero.
const sessionCookie = Astro.cookies.get("admin_session");
const isAdmin = isValidSessionValue(sessionCookie?.value);
---

<footer class="bg-gray-900 text-gray-300 py-12 border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Brand -->
            <div>
                <h3 class="text-white text-lg font-bold mb-4">
                    Metamorfosis Real
                </h3>
                <p class="text-sm">
                    Optimización metabólica e ingeniería humana para una vida
                    sin límites.
                </p>

                <!-- Social Icons (Moved here to match typical layout, or keep separate if preferred, but user didn't specify position so I'll keep them here or below) -->
                <div class="flex items-center gap-4 mt-6">
                    <a
                        href="https://youtube.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-gray-400 hover:text-[#00C49A] transition-colors duration-300"
                    >
                        <Youtube class="w-5 h-5" />
                        <span class="sr-only">YouTube</span>
                    </a>
                    <a
                        href="https://facebook.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-gray-400 hover:text-[#00C49A] transition-colors duration-300"
                    >
                        <Facebook class="w-5 h-5" />
                        <span class="sr-only">Facebook</span>
                    </a>
                    <a
                        href="https://instagram.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-gray-400 hover:text-[#00C49A] transition-colors duration-300"
                    >
                        <Instagram class="w-5 h-5" />
                        <span class="sr-only">Instagram</span>
                    </a>
                    <a
                        href="https://tiktok.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-gray-400 hover:text-[#00C49A] transition-colors duration-300"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"
                            ></path>
                        </svg>
                        <span class="sr-only">TikTok</span>
                    </a>
                </div>
            </div>

            <!-- Navigation -->
            <div>
                <h4 class="text-white font-semibold mb-4">Navegación</h4>
                <ul class="space-y-2 text-sm">
                    <li>
                        <a href="/" class="hover:text-[#00C49A] transition"
                            >Inicio</a
                        >
                    </li>
                    <li>
                        <a href="/posts" class="hover:text-[#00C49A] transition"
                            >Artículos</a
                        >
                    </li>
                    <li>
                        <a
                            href="/sobre-mi"
                            class="hover:text-[#00C49A] transition">Sobre Mí</a
                        >
                    </li>
                </ul>
            </div>

            <!-- Legal -->
            <div>
                <h4 class="text-white font-semibold mb-4">Legal</h4>
                <ul class="space-y-2 text-sm">
                    <li>
                        <a
                            href="/terminos"
                            class="hover:text-[#00C49A] transition"
                            >Términos y Condiciones</a
                        >
                    </li>
                    <li>
                        <a
                            href="/privacidad"
                            class="hover:text-[#00C49A] transition"
                            >Política de Privacidad</a
                        >
                    </li>
                    <li class="pt-2 text-xs text-gray-500 italic">
                        metamorfosisvitaloficial@gmail.com
                    </li>
                </ul>
            </div>
        </div>

        <!-- Copyright & Admin Entry -->
        <div
            class="w-full flex flex-col sm:flex-row items-center justify-between gap-2 py-4 border-t border-white/10 mt-8"
        >
            <div class="text-xs text-[#4a637e]">
                © {new Date().getFullYear()} Metamorfosis Real. Todos los derechos
                reservados.
            </div>
            <div class="flex items-center gap-4">
                <a
                    href="/privacidad"
                    class="text-xs text-[#4a637e] hover:text-[#007BFF] transition-colors duration-200 font-medium"
                    >Privacidad</a
                >
                <a
                    href="/terminos"
                    class="text-xs text-[#4a637e] hover:text-[#007BFF] transition-colors duration-200 font-medium"
                    >Términos</a
                >
                <a
                    href="/admin"
                    class="flex items-center gap-1 text-xs text-[#4a637e] hover:text-[#007BFF] transition-colors duration-200 font-medium"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-3.5 h-3.5"
                        fill="none"
                        viewBox="0 0 20 20"
                        stroke="currentColor"
                        stroke-width="1.5"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M10 12a2 2 0 100-4 2 2 0 000 4zm7-2a7 7 0 11-14 0 7 7 0 0114 0zm-7-4v2m0 4v2"
                        ></path>
                    </svg>
                    Admin
                </a>
            </div>
        </div>
    </div>
</footer>
