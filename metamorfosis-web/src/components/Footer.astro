---
import { Instagram, Youtube } from "lucide-astro";
import { isValidSessionValue } from "../lib/auth";

// Detección de sesión admin para mostrar/ocultar UI condicional.
// El check de production de ADMIN_PASSWORD vive solo en endpoints/páginas que
// realmente lo necesitan; el footer no debe romper el render del sitio entero.
const sessionCookie = Astro.cookies.get("admin_session");
const isAdmin = isValidSessionValue(sessionCookie?.value);

// Redes sociales activas de Metamorfosis Real (SPEC-011).
// Si en el futuro agregás/quitás una red, editá solo este bloque.
const SOCIAL_LINKS = {
    youtube: "https://www.youtube.com/@Metamorfosisreal",
    instagram: "https://www.instagram.com/metamorfosisreal",
    tiktok: "https://www.tiktok.com/@metamorfosisreal",
} as const;
---

<footer class="bg-bg-surface text-text-secondary py-12 border-t border-white/[0.06]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Brand -->
            <div>
                <h3 class="text-text-primary text-base font-semibold mb-3 tracking-tight">
                    Metamorfosis Real
                </h3>
                <p class="text-sm leading-relaxed">
                    Optimización metabólica e ingeniería humana para una vida
                    sin límites.
                </p>

                <!-- Redes sociales activas: YouTube, Instagram, TikTok -->
                <div class="flex items-center gap-4 mt-5">
                    <a
                        href={SOCIAL_LINKS.youtube}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-accent transition-colors"
                        aria-label="YouTube"
                    >
                        <Youtube class="w-5 h-5" />
                        <span class="sr-only">YouTube</span>
                    </a>
                    <a
                        href={SOCIAL_LINKS.instagram}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-accent transition-colors"
                        aria-label="Instagram"
                    >
                        <Instagram class="w-5 h-5" />
                        <span class="sr-only">Instagram</span>
                    </a>
                    <a
                        href={SOCIAL_LINKS.tiktok}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-text-muted hover:text-accent transition-colors"
                        aria-label="TikTok"
                    >
                        {/* SVG oficial de TikTok */}
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.84-.1z"
                            />
                        </svg>
                        <span class="sr-only">TikTok</span>
                    </a>
                </div>
            </div>

            <!-- Navigation -->
            <div>
                <h4 class="text-text-primary text-sm font-semibold mb-3 tracking-tight">Navegación</h4>
                <ul class="space-y-2 text-sm">
                    <li>
                        <a href="/" class="hover:text-accent transition-colors"
                            >Inicio</a
                        >
                    </li>
                    <li>
                        <a href="/biblioteca" class="hover:text-accent transition-colors"
                            >Artículos</a
                        >
                    </li>
                    <li>
                        <a
                            href="/sobre-mi"
                            class="hover:text-accent transition-colors">Sobre mí</a
                        >
                    </li>
                </ul>
            </div>

            <!-- Legal -->
            <div>
                <h4 class="text-text-primary text-sm font-semibold mb-3 tracking-tight">Legal</h4>
                <ul class="space-y-2 text-sm">
                    <li>
                        <a
                            href="/terminos"
                            class="hover:text-accent transition-colors"
                            >Términos y condiciones</a
                        >
                    </li>
                    <li>
                        <a
                            href="/privacidad"
                            class="hover:text-accent transition-colors"
                            >Política de privacidad</a
                        >
                    </li>
                    <li>
                        <a
                            href="/disclaimer-medico"
                            class="hover:text-accent transition-colors"
                            >Aviso médico</a
                        >
                    </li>
                    <li class="pt-2 text-xs text-text-muted">
                        metamorfosisvitaloficial@gmail.com
                    </li>
                </ul>
            </div>
        </div>

        <!-- SPEC-080: disclaimer médico inline al pie del footer.
             Garantiza que el aviso aparece en TODAS las páginas del sitio
             aunque el usuario no entre a /disclaimer-medico. -->
        <div class="border-t border-white/[0.06] mt-8 pt-6 text-center">
            <p class="text-xs text-text-muted leading-relaxed max-w-3xl mx-auto">
                ⚠ Información educativa, no médica. Metamorfosis Real publica contenido
                informativo y herramientas de auto-evaluación. NO constituye diagnóstico,
                tratamiento ni asesoría médica profesional. Consulta a un profesional
                de la salud antes de cambiar tu dieta, ejercicio o medicación.{" "}
                <a
                    href="/disclaimer-medico"
                    class="text-accent hover:text-accent-strong underline underline-offset-2"
                    >Leer disclaimer completo</a
                >.
            </p>
        </div>

        <!-- Copyright & Admin Entry -->
        <div
            class="w-full flex flex-col sm:flex-row items-center justify-between gap-3 py-4 border-t border-white/[0.06] mt-8"
        >
            <div class="text-xs text-text-muted">
                © {new Date().getFullYear()} Metamorfosis Real. Todos los derechos
                reservados.
            </div>
            <div class="flex items-center gap-4">
                <a
                    href="/privacidad"
                    class="text-xs text-text-muted hover:text-accent transition-colors font-medium"
                    >Privacidad</a
                >
                <a
                    href="/terminos"
                    class="text-xs text-text-muted hover:text-accent transition-colors font-medium"
                    >Términos</a
                >
                {
                    isAdmin && (
                        <a
                            href="/admin/dashboard"
                            class="flex items-center gap-1.5 text-xs text-accent hover:text-text-primary transition-colors font-medium"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-3.5 h-3.5"
                                fill="none"
                                viewBox="0 0 20 20"
                                stroke="currentColor"
                                stroke-width="1.5"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M10 12a2 2 0 100-4 2 2 0 000 4zm7-2a7 7 0 11-14 0 7 7 0 0114 0zm-7-4v2m0 4v2"
                                />
                            </svg>
                            Admin
                        </a>
                    )
                }
            </div>
        </div>
    </div>
</footer>
