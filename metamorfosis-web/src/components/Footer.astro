---
import { Instagram, Youtube } from "lucide-astro";
import { isValidSessionValue } from "../lib/auth";

// Detección de sesión admin para mostrar/ocultar UI condicional.
// El check de production de ADMIN_PASSWORD vive solo en endpoints/páginas que
// realmente lo necesitan; el footer no debe romper el render del sitio entero.
const sessionCookie = Astro.cookies.get("admin_session");
const isAdmin = isValidSessionValue(sessionCookie?.value);

// Redes sociales activas de Metamorfosis Real (SPEC-011).
// Si en el futuro agregás/quitás una red, editá solo este bloque.
const SOCIAL_LINKS = {
    youtube: "https://www.youtube.com/@Metamorfosisreal",
    instagram: "https://www.instagram.com/metamorfosisreal",
    tiktok: "https://www.tiktok.com/@metamorfosisreal",
} as const;
---

<footer class="bg-gray-900 text-gray-300 py-12 border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Brand -->
            <div>
                <h3 class="text-white text-lg font-bold mb-4">
                    Metamorfosis Real
                </h3>
                <p class="text-sm">
                    Optimización metabólica e ingeniería humana para una vida
                    sin límites.
                </p>

                <!-- Redes sociales activas: YouTube, Instagram, TikTok -->
                <div class="flex items-center gap-4 mt-6">
                    <a
                        href={SOCIAL_LINKS.youtube}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-gray-400 hover:text-[#00C49A] transition-colors duration-300"
                        aria-label="YouTube"
                    >
                        <Youtube class="w-5 h-5" />
                        <span class="sr-only">YouTube</span>
                    </a>
                    <a
                        href={SOCIAL_LINKS.instagram}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-gray-400 hover:text-[#00C49A] transition-colors duration-300"
                        aria-label="Instagram"
                    >
                        <Instagram class="w-5 h-5" />
                        <span class="sr-only">Instagram</span>
                    </a>
                    <a
                        href={SOCIAL_LINKS.tiktok}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-gray-400 hover:text-[#00C49A] transition-colors duration-300"
                        aria-label="TikTok"
                    >
                        {/* SVG oficial de TikTok */}
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.84-.1z"
                            />
                        </svg>
                        <span class="sr-only">TikTok</span>
                    </a>
                </div>
            </div>

            <!-- Navigation -->
            <div>
                <h4 class="text-white font-semibold mb-4">Navegación</h4>
                <ul class="space-y-2 text-sm">
                    <li>
                        <a href="/" class="hover:text-[#00C49A] transition"
                            >Inicio</a
                        >
                    </li>
                    <li>
                        <a href="/biblioteca" class="hover:text-[#00C49A] transition"
                            >Artículos</a
                        >
                    </li>
                    <li>
                        <a
                            href="/sobre-mi"
                            class="hover:text-[#00C49A] transition">Sobre Mí</a
                        >
                    </li>
                </ul>
            </div>

            <!-- Legal -->
            <div>
                <h4 class="text-white font-semibold mb-4">Legal</h4>
                <ul class="space-y-2 text-sm">
                    <li>
                        <a
                            href="/terminos"
                            class="hover:text-[#00C49A] transition"
                            >Términos y Condiciones</a
                        >
                    </li>
                    <li>
                        <a
                            href="/privacidad"
                            class="hover:text-[#00C49A] transition"
                            >Política de Privacidad</a
                        >
                    </li>
                    <!-- SPEC-030b: text-gray-500 → text-gray-400 (WCAG AA sobre bg-gray-900: 3.3:1 → 6.4:1). -->
                    <li class="pt-2 text-xs text-gray-400 italic">
                        metamorfosisvitaloficial@gmail.com
                    </li>
                </ul>
            </div>
        </div>

        <!-- Copyright & Admin Entry -->
        <div
            class="w-full flex flex-col sm:flex-row items-center justify-between gap-2 py-4 border-t border-white/10 mt-8"
        >
            {/* SPEC-030b: text-[#4a637e] (~3.3:1 contrast) → text-gray-400 (6.4:1, WCAG AA). */}
            <div class="text-xs text-gray-400">
                © {new Date().getFullYear()} Metamorfosis Real. Todos los derechos
                reservados.
            </div>
            <div class="flex items-center gap-4">
                <a
                    href="/privacidad"
                    class="text-xs text-gray-400 hover:text-[#007BFF] transition-colors duration-200 font-medium"
                    >Privacidad</a
                >
                <a
                    href="/terminos"
                    class="text-xs text-gray-400 hover:text-[#007BFF] transition-colors duration-200 font-medium"
                    >Términos</a
                >
                {
                    isAdmin && (
                        <a
                            href="/admin/dashboard"
                            class="flex items-center gap-1 text-xs text-[#00C49A] hover:text-white transition-colors duration-200 font-medium"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-3.5 h-3.5"
                                fill="none"
                                viewBox="0 0 20 20"
                                stroke="currentColor"
                                stroke-width="1.5"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M10 12a2 2 0 100-4 2 2 0 000 4zm7-2a7 7 0 11-14 0 7 7 0 0114 0zm-7-4v2m0 4v2"
                                />
                            </svg>
                            Admin
                        </a>
                    )
                }
            </div>
        </div>
    </div>
</footer>
