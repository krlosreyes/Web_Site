---
import { Zap } from 'lucide-astro';
---
<div class="border-l-4 border-health-green bg-bg-surface/50 p-6 rounded-r-2xl my-10 group hover:bg-bg-surface transition-all shadow-xl shadow-health-green/5">
    <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-full bg-health-green/10 flex items-center justify-center text-health-green group-hover:scale-110 transition-transform">
            <Zap size={20} />
        </div>
        <h4 class="font-heading font-bold text-lg text-text-primary uppercase tracking-wider">Estrategia Práctica</h4>
    </div>
    <div class="text-text-secondary leading-relaxed text-sm">
        <slot />
    </div>
</div>
