---
import { Zap } from 'lucide-astro';
---
<div class="border-l-2 border-accent bg-bg-elevated p-5 md:p-6 rounded-lg my-8 group hover:border-accent/70 transition-colors">
    <div class="flex items-center gap-3 mb-3">
        <div class="w-9 h-9 rounded-lg bg-accent/10 border border-accent/20 flex items-center justify-center text-accent">
            <Zap size={18} />
        </div>
        <h4 class="font-heading font-semibold text-base text-text-primary tracking-tight">Estrategia práctica</h4>
    </div>
    <div class="text-gray-300 leading-relaxed text-sm">
        <slot />
    </div>
</div>
