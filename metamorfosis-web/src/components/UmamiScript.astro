---
/**
 * UmamiScript — analytics real con Umami cloud (SPEC-028).
 *
 * Inyecta el script de tracking SOLO si:
 *   - Estamos en producción (no contaminamos dev/preview con visitas).
 *   - La env var PUBLIC_UMAMI_WEBSITE_ID está seteada.
 *   - El path actual NO empieza con /admin (excluye tráfico interno).
 *
 * Setup: ver SPEC-028 para los pasos en Umami cloud + Hostinger env var.
 *
 * Privacy: Umami no setea cookies y no recolecta PII por default —
 * no requiere banner GDPR/CCPA.
 *
 * SPEC-028b: leemos la env var con `process.env.*` primero (runtime, server),
 * con fallback a `import.meta.env.*` (build-time inlining). Bajo SSR esto
 * permite que un cambio en la env var de Hostinger surta efecto sin tener
 * que disparar un rebuild completo. `import.meta.env.PUBLIC_*` queda como
 * red de seguridad para `astro dev` y otros contextos build-time-only.
 */
import { isKnownBotUserAgent } from '../lib/legacy/botDetection';

const path = Astro.url.pathname;
const isAdminPath = path.startsWith('/admin');
const websiteId =
    process.env.PUBLIC_UMAMI_WEBSITE_ID ||
    import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const isProd =
    process.env.NODE_ENV === 'production' || import.meta.env.PROD;
// SPEC-094: no inyectamos el tracker si el UA es un bot conocido
// (crawlers de Meta, X, LinkedIn, etc. que hacen link previews).
// Ahorra ruido en Umami sin costo para el render del HTML.
const userAgent = Astro.request.headers.get('user-agent');
const isBot = isKnownBotUserAgent(userAgent);
const enabled = isProd && !!websiteId && !isAdminPath && !isBot;
---

{
    enabled && (
        <script
            defer
            src="https://cloud.umami.is/script.js"
            data-website-id={websiteId}
        />
    )
}
