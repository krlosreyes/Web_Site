---
import { Timer, Apple, Droplets, Moon, Dumbbell } from "lucide-astro";

/**
 * SPEC-059: cards de pilares centradas y linkeables.
 *
 * Cada card es un <a> que navega a `/biblioteca?pilar={id}` — el filtro
 * de la biblioteca lee el query param y aplica el filtro automáticamente
 * (SPEC-046 + SPEC-059).
 *
 * Mapeo display → id canónico (lib/constants/pillars.ts):
 *   - "Ayuno Intermitente"  → `ayuno`
 *   - "Alimentación"        → `nutricion`
 *   - "Hidratación"         → `hidratacion`
 *   - "Sueño"               → `sueno`
 *   - "Ejercicio"           → `ejercicio`
 *
 * El display copy se mantiene tal cual (más amigable que los IDs) — los
 * IDs viven en URL/Firestore para taxonomía cross-feature consistente.
 */

interface PillarCard {
    id: 'ayuno' | 'nutricion' | 'hidratacion' | 'sueno' | 'ejercicio';
    title: string;
    description: string;
    Icon: typeof Timer;
}

const CARDS: PillarCard[] = [
    {
        id: 'ayuno',
        title: 'Ayuno Intermitente',
        description: 'Sincroniza tu metabolismo y activa la autofagia para una reparación celular profunda.',
        Icon: Timer,
    },
    {
        id: 'nutricion',
        title: 'Alimentación',
        description: 'Nutre tu biología con alimentos densos que estabilicen tu energía y hormonas.',
        Icon: Apple,
    },
    {
        id: 'hidratacion',
        title: 'Hidratación',
        description: 'Optimiza el equilibrio mineral y la conductividad celular para un rendimiento máximo.',
        Icon: Droplets,
    },
    {
        id: 'sueno',
        title: 'Sueño',
        description: 'Domina tu ritmo circadiano para una recuperación cognitiva y hormonal absoluta.',
        Icon: Moon,
    },
    {
        id: 'ejercicio',
        title: 'Ejercicio',
        description: 'Construye fuerza y resiliencia metabólica a través del movimiento estratégico.',
        Icon: Dumbbell,
    },
];
---

<section id="pilares" class="py-24 px-6 bg-bg-surface/30">
  <div class="container mx-auto max-w-7xl">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-heading font-bold mb-4 tracking-tight">
        Los 5 Pilares para tu Metamorfosis Real
      </h2>
      <p class="text-text-secondary max-w-xl mx-auto text-lg leading-relaxed">
        Nuestro método se basa en la optimización de los 5 sistemas biológicos
        fundamentales para tu transformación.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6">
      {CARDS.map(({ id, title, description, Icon }) => (
        <a
          href={`/biblioteca?pilar=${id}`}
          aria-label={`Ver artículos sobre ${title}`}
          class="glass p-8 group hover:-translate-y-2 transition-all duration-500 hover:shadow-xl hover:shadow-accent-blue/10 hover:border-accent-blue/30 focus:outline-none focus:ring-2 focus:ring-accent-blue/40 cursor-pointer"
        >
          {/* SPEC-059: mx-auto centra el icon container horizontalmente
              en todas las resoluciones, sin importar el ancho de la card. */}
          <div
            class="w-16 h-16 rounded-2xl bg-accent-blue/10 flex items-center justify-center text-accent-blue mb-6 mx-auto group-hover:scale-105 transition-transform"
          >
            <Icon size={32} />
          </div>
          <h3 class="text-xl font-bold mb-3 text-text-primary">
            {title}
          </h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            {description}
          </p>
        </a>
      ))}
    </div>
  </div>
</section>
