---
import { Timer, Apple, Droplets, Moon, Dumbbell } from "lucide-astro";

/**
 * SPEC-059: cards de pilares centradas y linkeables.
 *
 * Cada card es un <a> que navega a `/biblioteca?pilar={id}` — el filtro
 * de la biblioteca lee el query param y aplica el filtro automáticamente
 * (SPEC-046 + SPEC-059).
 *
 * Mapeo display → id canónico (lib/constants/pillars.ts):
 *   - "Ayuno Intermitente"  → `ayuno`
 *   - "Alimentación"        → `nutricion`
 *   - "Hidratación"         → `hidratacion`
 *   - "Sueño"               → `sueno`
 *   - "Ejercicio"           → `ejercicio`
 *
 * El display copy se mantiene tal cual (más amigable que los IDs) — los
 * IDs viven en URL/Firestore para taxonomía cross-feature consistente.
 */

interface PillarCard {
    id: 'ayuno' | 'nutricion' | 'hidratacion' | 'sueno' | 'ejercicio';
    title: string;
    description: string;
    Icon: typeof Timer;
}

const CARDS: PillarCard[] = [
    {
        id: 'ayuno',
        title: 'Ayuno Intermitente',
        description: 'Sincroniza tu metabolismo y activa la autofagia para una reparación celular profunda.',
        Icon: Timer,
    },
    {
        id: 'nutricion',
        title: 'Alimentación',
        description: 'Nutre tu biología con alimentos densos que estabilicen tu energía y hormonas.',
        Icon: Apple,
    },
    {
        id: 'hidratacion',
        title: 'Hidratación',
        description: 'Optimiza el equilibrio mineral y la conductividad celular para un rendimiento máximo.',
        Icon: Droplets,
    },
    {
        id: 'sueno',
        title: 'Sueño',
        description: 'Domina tu ritmo circadiano para una recuperación cognitiva y hormonal absoluta.',
        Icon: Moon,
    },
    {
        id: 'ejercicio',
        title: 'Ejercicio',
        description: 'Construye fuerza y resiliencia metabólica a través del movimiento estratégico.',
        Icon: Dumbbell,
    },
];
---

<section id="pilares" class="py-20 md:py-24 px-6">
  <div class="container mx-auto max-w-7xl">
    <div class="text-center mb-14">
      <p class="text-[11px] font-bold text-accent uppercase tracking-[0.2em] mb-3">Nuestro método</p>
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-3 tracking-tight text-text-primary">
        Los 5 pilares para tu metamorfosis real
      </h2>
      <p class="text-text-secondary max-w-xl mx-auto text-base leading-relaxed">
        Optimizamos los 5 sistemas biológicos fundamentales para tu transformación.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4">
      {CARDS.map(({ id, title, description, Icon }) => (
        <a
          href={`/biblioteca?pilar=${id}`}
          aria-label={`Ver artículos sobre ${title}`}
          class="bg-bg-surface border border-white/[0.06] rounded-xl p-6 group hover:border-accent/30 hover:bg-bg-elevated transition-colors focus:outline-none focus:border-accent/50 cursor-pointer"
        >
          {/* mx-auto centra el icono horizontalmente en todas las resoluciones. */}
          <div
            class="w-12 h-12 rounded-lg bg-accent/10 border border-accent/15 flex items-center justify-center text-accent mb-5 mx-auto group-hover:bg-accent/15 transition-colors"
          >
            <Icon size={24} />
          </div>
          <h3 class="text-base font-semibold mb-2 text-text-primary tracking-tight text-center">
            {title}
          </h3>
          <p class="text-sm text-text-secondary leading-relaxed text-center">
            {description}
          </p>
        </a>
      ))}
    </div>
  </div>
</section>
