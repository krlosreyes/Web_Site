---
/**
 * SPEC-117: botón a la ficha de Elena en App Store.
 * Texto propio, sin el distintivo oficial de Apple (sus guías piden usar el
 * badge oficial sin modificar; un botón de texto evita usarlo mal).
 */
import { ELENA_APP_STORE_URL } from "../lib/constants/app";

interface Props {
    source: string;
    variant?: "primary" | "secondary";
    label?: string;
}

const { source, variant = "primary", label = "Descarga Elena gratis en App Store" } = Astro.props;
const styles =
    variant === "primary"
        ? "bg-accent text-bg-base hover:bg-accent-strong"
        : "bg-bg-surface/60 text-text-primary border border-white/[0.12] hover:bg-bg-surface hover:border-white/[0.2]";
---

<a
    href={ELENA_APP_STORE_URL}
    target="_blank"
    rel="noopener noreferrer"
    data-umami-event="cta_app_store"
    data-umami-event-source={source}
    class={`inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg font-semibold text-base transition-colors ${styles}`}
>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="6" y="2" width="12" height="20" rx="2.5"></rect>
        <line x1="11" y1="18" x2="13" y2="18"></line>
    </svg>
    {label}
</a>
